---
import '../styles/main.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  /** Extra JSON-LD nodes merged into the page graph. */
  jsonLd?: Record<string, unknown>[];
  /**
   * The visible FAQ of the page. The same array renders the FAQ and builds the
   * FAQPage node, so the structured answers are word-for-word the answers a
   * reader sees.
   */
  faq?: { q: string; a: string }[];
  /** When set, the page is announced as a product with an offer. */
  product?: {
    name: string;
    description: string;
    sku?: string;
    /** Product family, e.g. "Titanium Plate & Sheet". */
    category?: string;
    /** Grades and UNS numbers, e.g. "Grade 2 Titanium / UNS R50400". */
    material?: string;
    /** The shape sold, e.g. "Plate & Sheet". */
    additionalType?: string;
    /** The product picture, absolute or site-relative. */
    image?: string;
    /** Parameters of the product, one entry per value. */
    additionalProperty?: { name: string; value: string; unitText?: string }[];
  };
}

const {
  title,
  description = site.description,
  ogImage = site.seo.ogImage,
  canonical,
  jsonLd = [],
  faq = [],
  product,
} = Astro.props;

/**
 * Google Tag is optional and environment-gated.
 *
 * With no container and no measurement ID configured, nothing is emitted:
 * no third-party script, no `dataLayer`, no cookie. The built HTML stays
 * identical to a build without analytics, so a new site with no traffic yet
 * carries no consent or performance cost.
 *
 * Set both variables to enable it:
 *   PUBLIC_GTM_ID=GTM-XXXXXX
 *   PUBLIC_GA4_ID=G-XXXXXXXXXX
 */
const gtmId = import.meta.env.PUBLIC_GTM_ID || '';
const ga4Id = import.meta.env.PUBLIC_GA4_ID || '';
const hasAnalytics = Boolean(gtmId && ga4Id);

const brandName = site.name;
// The brand already appears as a title segment — don't append it twice.
const hasBrand = title
  .split('|')
  .some((seg) => seg.trim().startsWith(brandName) || seg.trim().endsWith(brandName));
const fullTitle = hasBrand ? title : `${title} | ${brandName}`;

// Canonical must be absolute and point at the production origin, never the
// preview host, so search engines consolidate on the canonical domain.
const origin = site.url.replace(/\/$/, '');
const canonicalUrl = canonical
  ? new URL(canonical, origin).href
  : new URL(Astro.url.pathname, origin).href;
const ogImageUrl = new URL(ogImage, origin).href;

// --- Structured data ----------------------------------------------------
const organizationId = `${origin}/#organization`;
const websiteId = `${origin}/#website`;

const graph: Record<string, unknown>[] = [
  {
    '@type': 'Organization',
    '@id': organizationId,
    name: site.legalName,
    url: origin,
    logo: new URL('/favicon.svg', origin).href,
    description: site.description,
    email: site.contact.salesEmail,
    telephone: site.contact.phone,
    sameAs: Object.values(site.social).filter((v) => v && v !== '#'),
    // No `address`: we own no facility and publish no site address.
    // `foundingDate` is deliberately absent — the company is not registered yet.
    contactPoint: [
      {
        '@type': 'ContactPoint',
        contactType: 'sales',
        email: site.contact.salesEmail,
        telephone: site.contact.phone,
        availableLanguage: ['English', 'Chinese'],
      },
    ],
  },
  {
    '@type': 'WebSite',
    '@id': websiteId,
    url: origin,
    name: brandName,
    description: site.description,
    publisher: { '@id': organizationId },
    inLanguage: site.locale,
  },
  {
    '@type': 'BreadcrumbList',
    '@id': `${canonicalUrl}#breadcrumb`,
    itemListElement: (() => {
      const path = Astro.url.pathname.replace(/\/$/, '');
      const segments = path.split('/').filter(Boolean);
      const items = [{ '@type': 'ListItem', position: 1, name: 'Home', item: `${origin}/` }];
      let acc = '';
      segments.forEach((seg, i) => {
        acc += `/${seg}`;
        const label = seg
          .split('-')
          .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
          .join(' ');
        items.push({
          '@type': 'ListItem',
          position: i + 2,
          name: label,
          item: `${origin}${acc}/`,
        });
      });
      return items;
    })(),
  },
];

if (product) {
  graph.push({
    '@type': 'Product',
    '@id': `${canonicalUrl}#product`,
    name: product.name,
    description: product.description,
    url: canonicalUrl,
    brand: { '@type': 'Brand', name: brandName },
    manufacturer: { '@id': organizationId },
    ...(product.sku ? { sku: product.sku } : {}),
    // The condition is the same for every product we make: new, not used.
    itemCondition: 'https://schema.org/NewCondition',
    ...(product.category ? { category: product.category } : {}),
    ...(product.material ? { material: product.material } : {}),
    ...(product.additionalType ? { additionalType: product.additionalType } : {}),
    ...(product.image
      ? { image: new URL(product.image, origin).href }
      : {}),
    ...(product.additionalProperty
      ? {
          additionalProperty: product.additionalProperty.map((property) => ({
            '@type': 'PropertyValue',
            name: property.name,
            value: property.value,
            ...(property.unitText ? { unitText: property.unitText } : {}),
          })),
        }
      : {}),
  });
}

for (const node of jsonLd) graph.push(node);

/**
 * The FAQPage node is built from the same array the page renders, so the
 * structured answer is word-for-word the answer visible on the page.
 */
if (faq.length > 0) {
  graph.push({
    '@type': 'FAQPage',
    '@id': `${canonicalUrl}#faq`,
    url: canonicalUrl,
    isPartOf: { '@id': websiteId },
    mainEntity: faq.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  });
}

/**
 * Every page is a WebPage. Pages that publish their own WebPage node keep it —
 * a second node with the same meaning would make the graph ambiguous — and
 * only the pages without one get it here.
 */
const hasWebPage = graph.some((node) => {
  const type = node['@type'];
  return Array.isArray(type) ? type.includes('WebPage') : type === 'WebPage';
});

if (!hasWebPage) {
  graph.push({
    '@type': 'WebPage',
    '@id': `${canonicalUrl}#webpage`,
    url: canonicalUrl,
    name: fullTitle,
    description,
    isPartOf: { '@id': websiteId },
    inLanguage: site.locale,
    breadcrumb: { '@id': `${canonicalUrl}#breadcrumb` },
    publisher: { '@id': organizationId },
    primaryImageOfPage: { '@type': 'ImageObject', url: ogImageUrl },
    ...(product ? { about: { '@id': `${canonicalUrl}#product` } } : {}),
  });
}

const jsonLdPayload = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });
---

<!DOCTYPE html>
<html lang={site.locale}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{fullTitle}</title>
  <link rel="canonical" href={canonicalUrl} />
  <meta name="robots" content="index, follow, max-image-preview:large" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:site_name" content={brandName} />
  <meta property="og:locale" content={site.localeCode} />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <script type="application/ld+json" is:inline set:html={jsonLdPayload} />

  {hasAnalytics && (
    <>
      {/* Google Tag Manager container. */}
      <script is:inline define:vars={{ gtmId }}>
        {`(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','${gtmId}');`}
      </script>
      {/* Google Analytics 4. The referrer host is recorded so AI assistant
          traffic can be separated from ordinary organic search. */}
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`}></script>
      <script is:inline define:vars={{ ga4Id }}>
        {`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${ga4Id}');gtag('set','ai_referrer_host',(document.referrer||'').split('/')[2]||'direct');`}
      </script>
    </>
  )}
</head>
<body>
  <Header />
  <main id="main-content">
    <slot />
  </main>
  <Footer />
</body>
</html>
