---
/**
 * Renderer of the anode page family.
 *
 * The markup follows the MMO wire anode page: the same utilities from
 * `src/styles/mmo-reference.css` (scoped under `.mmo-page`), the same band
 * rhythm and the same anchor navigation, so every page of the family reads
 * as part of one product cluster.
 *
 * The page is described by data only (`src/data/coating-page-model.ts`), so a
 * page is written as copy and never as markup.
 *
 * The structured data is built here rather than extracted from the markup, so
 * that the FAQ answers published to search engines are the answers a reader
 * actually sees.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import RFQForm from '../RFQForm.astro';
import PageBand from './PageBand.astro';
import { site } from '../../data/site';
import type { PageModel } from '../../data/coating-page-model';
import '../../styles/mmo-contrast.css';

interface Props {
  page: PageModel;
}

const { page } = Astro.props;
const origin = site.url.replace(/\/$/, '');
const canonicalUrl = new URL(Astro.url.pathname, origin).href;
const heroImage = page.hero.image;

const jsonLd: Record<string, unknown>[] = [
  {
    '@type': 'WebPage',
    '@id': `${canonicalUrl}#webpage`,
    url: canonicalUrl,
    name: page.seoTitle,
    description: page.description,
    isPartOf: { '@id': `${origin}/#website` },
    inLanguage: site.locale,
    primaryImageOfPage: { '@id': `${canonicalUrl}#primaryimage` },
    ...(page.product
      ? { about: { '@id': `${canonicalUrl}#product` } }
      : { about: { '@id': `${origin}/#organization` } }),
    breadcrumb: { '@id': `${canonicalUrl}#breadcrumb` },
  },
];

if (page.product) {
  jsonLd.push({
    '@type': 'Product',
    '@id': `${canonicalUrl}#product`,
    name: page.name,
    description: page.description,
    url: canonicalUrl,
    image: new URL(heroImage, origin).href,
    category: page.category ?? 'Titanium Anodes',
    brand: { '@type': 'Brand', name: site.name },
    manufacturer: { '@id': `${origin}/#organization` },
  });
}

if (page.faq.length > 0) {
  jsonLd.push({
    '@type': 'FAQPage',
    '@id': `${canonicalUrl}#faq`,
    mainEntity: page.faq.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  });
}
---

<BaseLayout
  title={page.seoTitle}
  description={page.description}
  ogImage={heroImage}
  jsonLd={jsonLd}
>
  <div class="mmo-page">
    <!-- Hero -->
    <div data-mmo-container="page" class="py-16 sm:py-20 lg:py-24">
      <div class="grid gap-12 lg:grid-cols-[minmax(0,1.05fr)_minmax(420px,.95fr)] lg:items-center">
        <div class="max-w-3xl">
          <p class="eyebrow">{page.hero.eyebrow}</p>
          <h1 class="mt-5 text-4xl font-extrabold leading-[1.06] tracking-tight text-slate-950 sm:text-5xl lg:text-[3.5rem]">{page.hero.title}</h1>
          <p class="mt-7 text-lg leading-8 text-slate-600 sm:text-xl">{page.hero.lead}</p>
          <div class="mt-9 flex flex-col gap-3 sm:flex-row">
            <a href="#rfq" class="inline-flex min-h-12 items-center justify-center rounded-xl bg-blue-600 px-7 py-3.5 text-sm font-bold text-white hover:bg-blue-700">{page.hero.primaryCta}</a>
            <a href="#technical-data" class="inline-flex min-h-12 items-center justify-center rounded-xl border border-slate-300 bg-white px-7 py-3.5 text-sm font-bold text-slate-800 hover:border-blue-500 hover:text-blue-700">{page.hero.secondaryCta}</a>
          </div>
          <div class="mt-7 border-l-4 border-blue-600 pl-5">
            <p class="text-sm leading-6 text-slate-600">{page.hero.boundary}</p>
          </div>
        </div>
        <div>
          <figure class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-soft">
            <img src={page.hero.image} alt={page.hero.imageAlt} class="aspect-[4/3] w-full object-cover" fetchpriority="high" decoding="async" loading="eager" />
          </figure>
          <div class="mt-4 grid grid-cols-2 gap-3 lg:grid-cols-4">
            {page.hero.thumbs.map((thumb) => (
              <figure class="overflow-hidden rounded-xl border border-slate-200 bg-white">
                <img src={thumb.src} alt={thumb.alt} class="aspect-[4/3] w-full object-cover" loading="lazy" decoding="async" />
              </figure>
            ))}
          </div>
        </div>
      </div>
      <div class="mt-12 grid overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-soft sm:grid-cols-2 lg:grid-cols-4">
        {page.hero.stats.map((stat) => (
          <div class="border-b border-slate-200 p-5 sm:border-r lg:border-b-0">
            <strong class="block text-2xl text-slate-950">{stat.value}</strong>
            <span class="mt-1 block text-sm text-slate-500">{stat.label}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Section navigation -->
    <nav class="anchor-nav overflow-x-auto border-b border-slate-200 bg-white" aria-label="Page sections">
      <div data-mmo-container="page" class="flex min-w-max gap-7 py-4 text-sm font-bold text-slate-600">
        {page.nav.map((item) => (
          <a href={item.href} class={item.href === '#rfq' ? 'text-blue-700' : 'hover:text-blue-700'}>{item.label}</a>
        ))}
      </div>
    </nav>

    <!-- Content sections -->
    {page.sections
      .filter((section) => !section.afterFaq)
      .map((section) => (
        <PageBand section={section} />
      ))}


    <!-- FAQ -->
    <section id="faq" class="py-20 bg-gray-50 border-t border-gray-200 scroll-mt-10">
      <div class="w-full max-w-7xl mx-auto px-5 sm:px-6 lg:px-8" data-mmo-container="page">
        <div class="text-center mb-12">
          <div class="text-blue-600 font-bold tracking-wider uppercase text-xs mb-3">FREQUENTLY ASKED QUESTIONS</div>
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">{page.faqHeading}</h2>
          <p class="text-lg text-gray-600 leading-relaxed max-w-3xl mx-auto">{page.faqLead}</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-start">
          {page.faq.map((item) => (
            <details class="group bg-white rounded-2xl shadow-sm border border-gray-200 transition-all duration-300">
              <summary class="p-5 text-lg font-semibold text-gray-900 cursor-pointer list-none flex justify-between items-center gap-4 [&::-webkit-details-marker]:hidden">
                {item.q}
                <svg class="w-5 h-5 shrink-0 group-hover:text-blue-600 transition-transform duration-300 group-open:rotate-180 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
              </summary>
              <div class="px-5 pb-5 text-gray-600 font-light leading-relaxed">{item.a}</div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- The band that closes the body, after the questions -->
    {page.sections
      .filter((section) => section.afterFaq)
      .map((section) => (
        <PageBand section={section} />
      ))}

    <!-- RFQ -->
    <section id="rfq" class={page.bandClass}>
      <div class="w-full max-w-7xl mx-auto px-5 sm:px-6 lg:px-8" data-mmo-container="page">
        <div class="grid gap-14 lg:grid-cols-2 lg:items-start">
          <div>
            <p class="text-sm font-extrabold uppercase tracking-[.16em] text-blue-300">{page.rfq.eyebrow}</p>
            <h2 class="mt-4 text-3xl font-extrabold tracking-tight sm:text-4xl">{page.rfq.title}</h2>
            <p class="mt-6 text-lg leading-8 text-slate-300">{page.rfq.lead}</p>
            <ul class="mt-8 space-y-4 text-slate-200">
              {page.rfq.points.map((point) => (
                <li class="flex gap-3">
                  <span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-blue-400"></span>
                  <span>{point}</span>
                </li>
              ))}
            </ul>
            <div class="mt-10 border-t border-slate-800 pt-8">
              <p class="text-sm text-slate-400">Prefer email?</p>
              <a href={`mailto:${site.contact.salesEmail}`} class="mt-2 block text-lg font-semibold text-white">{site.contact.salesEmail}</a>
              <p class="mt-3 text-sm text-slate-500">
                {site.sourcing.base}
              </p>
            </div>
          </div>
          <div class="rounded-3xl bg-white p-6 text-slate-900 shadow-2xl sm:p-8 lg:p-10">
            <RFQForm
              title={page.rfq.formTitle}
              subtitle={page.rfq.formSubtitle}
              variant="anode"
            />
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
