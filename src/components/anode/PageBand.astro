---
/**
 * Renders one band of a page.
 *
 * The bands follow the layout of the MMO wire anode page: a standard band of
 * blocks under a heading, a dark showcase band with a picture beside the
 * copy, a light boundary band of two contrasting cards, and a dark quality
 * band with a picture beside the copy.
 */
import PageBlocks from './PageBlocks.astro';
import type { PageSection } from '../../data/coating-page-model';

interface Props {
  section: PageSection;
}

const { section } = Astro.props;
const layout = section.layout ?? 'standard';
---

{
  layout === 'showcase' && (
    <section id={section.id} class={section.band}>
      <div class="w-full max-w-7xl mx-auto px-5 sm:px-6 lg:px-8" data-mmo-container="page">
        <div class="grid lg:grid-cols-12 gap-12 items-center">
          {section.image && (
            <div class="lg:col-span-5 relative">
              <div class="rounded-2xl overflow-hidden shadow-2xl relative aspect-[4/5] lg:aspect-auto lg:h-[600px]">
                <img src={section.image.src} alt={section.image.alt} class="w-full h-full object-cover" decoding="async" loading="lazy" />
                <div class="absolute inset-0 bg-blue-900/20 mix-blend-multiply"></div>
              </div>
            </div>
          )}
          <div class="lg:col-span-7">
            <div class="text-blue-300 font-bold tracking-wider uppercase text-xs mb-3">{section.eyebrow}</div>
            <h2 class="text-3xl md:text-4xl font-bold mb-6 text-white">{section.title}</h2>
            {section.intro && <p class="text-lg text-blue-100 mb-10 leading-relaxed">{section.intro}</p>}
            <PageBlocks blocks={section.blocks} />
            <a
              href="#rfq"
              class="inline-flex justify-center items-center px-8 py-4 bg-blue-600 text-white font-semibold rounded-xl hover:bg-blue-500 transition-colors cursor-pointer"
            >
              Send the Technical Data
            </a>
          </div>
        </div>
      </div>
    </section>
  )
}

{
  layout === 'boundary' && (
    <section id={section.id} class={section.band}>
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8" data-mmo-container="page">
        <div class="max-w-4xl">
          <p class="text-sm font-black uppercase tracking-[0.2em] text-blue-700">{section.eyebrow}</p>
          <h2 class="mt-3 text-3xl font-black tracking-tight text-slate-950 sm:text-4xl">{section.title}</h2>
          {section.intro && <p class="mt-6 text-lg leading-8 text-slate-700">{section.intro}</p>}
        </div>

        <div class="mt-10 grid gap-6 lg:grid-cols-2">
          {section.review && (
            <article class="rounded-3xl border border-blue-100 bg-blue-50 p-6 sm:p-8">
              <h3 class="text-xl font-black text-slate-950">{section.review.title}</h3>
              <ul class="mt-5 space-y-4 text-base leading-7 text-slate-700">
                {section.review.points.map((point) => (
                  <li class="flex gap-3">
                    <span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-blue-600"></span>
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
            </article>
          )}
          {section.limits && (
            <article class="rounded-3xl border border-amber-200 bg-amber-50 p-6 sm:p-8">
              <h3 class="text-xl font-black text-slate-950">{section.limits.title}</h3>
              <ul class="mt-5 space-y-4 text-base leading-7 text-slate-700">
                {section.limits.points.map((point) => (
                  <li class="flex gap-3">
                    <span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-amber-500"></span>
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
            </article>
          )}
        </div>

        {section.note && (
          <div class="mt-8 rounded-3xl border border-slate-200 bg-white p-6 sm:p-8">
            <h3 class="text-xl font-black text-slate-950">{section.note.title}</h3>
            <p class="mt-2 leading-7 text-slate-700">{section.note.body}</p>
          </div>
        )}

        {section.related && (
          <div class="mt-8 rounded-3xl border border-slate-200 bg-slate-50 p-6 sm:p-8">
            <h3 class="text-xl font-black text-slate-950">{section.related.title}</h3>
            <p class="mt-2 leading-7 text-slate-700">{section.related.intro}</p>
            <nav class="mt-5 flex flex-wrap gap-3" aria-label="Related anode products">
              {section.related.links.map((link) => (
                <a
                  href={link.href}
                  class="inline-flex min-h-11 items-center rounded-full border border-blue-200 bg-white px-4 py-2 text-sm font-bold text-blue-800 transition hover:border-blue-500 hover:text-blue-950 focus:outline-none focus:ring-2 focus:ring-blue-600 focus:ring-offset-2"
                >
                  {link.label}
                </a>
              ))}
            </nav>
          </div>
        )}
      </div>
    </section>
  )
}

{
  layout === 'quality' && (
    <section id={section.id} class={section.band}>
      <div data-mmo-container="page" class="grid gap-12 lg:grid-cols-[1.05fr_.95fr] lg:items-center">
        <div>
          <p class="text-sm font-extrabold uppercase tracking-[.16em] text-blue-300">{section.eyebrow}</p>
          <h2 class="mt-4 text-3xl font-extrabold tracking-tight sm:text-4xl">{section.title}</h2>
          {section.intro && <p class="mt-6 text-lg leading-8 text-slate-700">{section.intro}</p>}
          <div class="mt-9 grid gap-5 sm:grid-cols-2">
            {section.blocks
              .filter((block) => block.kind === 'steps')
              .flatMap((block) => block.items ?? [])
              .map((item, index) => (
                <div class="rounded-2xl border border-white/15 bg-white/5 p-5">
                  <h3 class="font-bold">
                    {index + 1}. {item.title}
                  </h3>
                  <p class="mt-2 text-sm leading-6 text-slate-700">{item.body}</p>
                </div>
              ))}
          </div>
          {section.blocks
            .filter((block) => block.kind === 'paragraphs')
            .flatMap((block) => block.paragraphs ?? [])
            .map((text) => (
              <p class="mt-7 text-sm leading-6 text-slate-600">{text}</p>
            ))}
        </div>
        {section.image && (
          <figure class="overflow-hidden rounded-3xl border border-white/15 bg-white/5">
            <img src={section.image.src} alt={section.image.alt} class="aspect-[4/3] w-full object-cover" loading="lazy" decoding="async" />
            {section.image.caption && (
              <figcaption class="p-5 text-sm leading-6 text-slate-700">{section.image.caption}</figcaption>
            )}
          </figure>
        )}
      </div>
    </section>
  )
}

{
  layout === 'standard' && (
    <section id={section.id} class={section.band}>
      <div class="w-full max-w-7xl mx-auto px-5 sm:px-6 lg:px-8" data-mmo-container="page">
        <div class="max-w-3xl mb-12">
          <div class="text-blue-600 font-bold tracking-wider uppercase text-xs mb-3">{section.eyebrow}</div>
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">{section.title}</h2>
          {section.intro && <p class="text-lg text-gray-600 leading-relaxed">{section.intro}</p>}
        </div>
        <PageBlocks blocks={section.blocks} />
      </div>
    </section>
  )
}
