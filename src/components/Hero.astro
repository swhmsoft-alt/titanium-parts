---
import Icon from './Icon.astro';
interface Props { title?: string; subtitle?: string; eyebrow?: string; align?: 'left' | 'center'; }
const { title = 'Titanium Products Manufacturer & Engineering Supplier', subtitle = 'Factory-direct titanium mill products, MMO and platinized titanium anodes, custom-fabricated parts, and PEM electrolyzer systems for global OEMs, EPC contractors, and system integrators.', eyebrow = 'Direct Factory · Custom Engineering · Global B2B Supply', align = 'left' } = Astro.props;
---
<section class={`hero hero-${align}`}>
  <div class="hero-bg">
    <div class="hero-bg-image"></div>
    <div class="hero-bg-overlay"></div>
  </div>
  <div class="container">
    <div class="hero-content">
      <span class="hero-eyebrow">{eyebrow}</span>
      <h1 class="hero-title">{title}</h1>
      <p class="hero-subtitle">{subtitle}</p>
      <div class="hero-actions">
        <a href="/contact/" class="btn btn-primary btn-lg">Get a Quote</a>
        <a href="/titanium-products/" class="btn btn-white btn-lg">Explore Products</a>
      </div>
      <div class="hero-features">
        <div class="hero-feature"><Icon name="check-circle" size={18} /> Direct Factory Supply</div>
        <div class="hero-feature"><Icon name="check-circle" size={18} /> Custom Engineering</div>
        <div class="hero-feature"><Icon name="check-circle" size={18} /> Global B2B Shipping</div>
        <div class="hero-feature"><Icon name="check-circle" size={18} /> 1-Business-Day Response</div>
      </div>
    </div>
  </div>
</section>
<style>
  .hero { position: relative; padding: 5rem 0 6rem; color: #fff; overflow: hidden; min-height: 600px; display: flex; align-items: center; }
  .hero-bg { position: absolute; inset: 0; z-index: 0; }
  .hero-bg-image {
    position: absolute; inset: 0;
    background: linear-gradient(135deg, #0A213C 0%, #143B6B 50%, #1B4D89 100%);
    background-size: cover; background-position: center;
  }
  .hero-bg-image::after {
    content: ''; position: absolute; inset: 0;
    background-image:
      radial-gradient(circle at 20% 30%, rgba(27,77,137,0.5) 0%, transparent 50%),
      radial-gradient(circle at 80% 70%, rgba(230,57,70,0.2) 0%, transparent 50%);
  }
  .hero-bg-overlay { position: absolute; inset: 0; background: rgba(10,33,60,0.4); }
  .hero-content { position: relative; z-index: 1; max-width: 900px; }
  .hero-center .hero-content { margin: 0 auto; text-align: center; }
  .hero-eyebrow {
    display: inline-block; padding: 0.5rem 1rem; margin-bottom: 1.5rem;
    background: rgba(230,57,70,0.2); border: 1px solid rgba(230,57,70,0.4);
    color: #fff; font-size: 0.8125rem; font-weight: 600;
    border-radius: var(--radius-full); letter-spacing: 0.05em;
  }
  .hero-title { font-size: clamp(2.25rem, 5vw, 3.75rem); font-weight: 800; line-height: 1.1; color: #fff; margin-bottom: 1.5rem; letter-spacing: -0.02em; }
  .hero-subtitle { font-size: clamp(1rem, 1.5vw, 1.25rem); line-height: 1.6; color: rgba(255,255,255,0.9); margin-bottom: 2rem; max-width: 750px; }
  .hero-actions { display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: 2.5rem; }
  .hero-center .hero-actions { justify-content: center; }
  .hero-features { display: flex; flex-wrap: wrap; gap: 1.5rem; }
  .hero-center .hero-features { justify-content: center; }
  .hero-feature { display: inline-flex; align-items: center; gap: 0.5rem; color: rgba(255,255,255,0.9); font-size: 0.9375rem; font-weight: 500; }
  .hero-feature :global(svg) { color: #4ADE80; }
</style>
