---
/**
 * The catalog blocks of a titanium product page.
 *
 * A page may replace the shared grades-and-forms block with its own blocks
 * when the grades and the product forms need different headings or card
 * layouts. The wording lives in `src/data/product-pages/<slug>.ts`.
 */
import type { CatalogSection } from '../../data/product-pages/standard';

interface Props {
  sections: CatalogSection[];
  M: string;
}

const { sections, M } = Astro.props;
---

{sections.map((s) => (
  <section id={s.id} class:list={['tp-section', { 'tp-alt': s.tone === 'alt' }]}>
    <div class="tp-inner">
      <p class="tp-eyebrow">{s.eyebrow}</p>
      <h2 class="tp-h2">{s.heading.replace('{M}', M)}</h2>
      {s.lede && <p class="tp-lede">{s.lede.replace('{M}', M)}</p>}
      <div class="tp-grid-4">
        {s.kind === 'grades' &&
          s.items.map((g) => (
            <article class="tp-card tp-form-card">
              {g.img && <div class="tp-form-img"><img src={g.img} alt={g.alt || g.title} loading="lazy" /></div>}
              <div class="tp-form-body">
                <h3>{g.title}</h3>
                {g.spec && <p class="tp-form-spec"><strong>Standard:</strong> {g.spec}</p>}
                {g.body && <p class="tp-form-text">{g.body}</p>}
              </div>
            </article>
          ))}
        {s.kind === 'forms' &&
          s.items.map((f) => (
            <article class="tp-form-pure">
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </article>
          ))}
        {s.kind === 'forms-links' &&
          s.items.map((f) => (
            <article class="tp-form-pure">
              <h3>{f.title}</h3>
              <p>{f.spec}</p>
              {f.href && (
                <a href={f.href} class="tp-form-link">
                  {s.linkText ? s.linkText.replace('{title}', f.title) : `View ${f.title} →`}
                </a>
              )}
            </article>
          ))}
        {s.kind === 'forms-cards' &&
          s.items.map((f) => (
            <article class="tp-card tp-form-card">
              {f.img && <div class="tp-form-img"><img src={f.img} alt={f.alt || f.title} loading="lazy" /></div>}
              <div class="tp-form-body">
                <h3>{f.title}</h3>
                {f.spec && <p class="tp-form-spec">{f.spec}</p>}
                {f.body && <p class="tp-form-text">{f.body}</p>}
                {s.note && <p class="tp-form-text tp-form-note"><em>{s.note}</em></p>}
              </div>
            </article>
          ))}
      </div>
    </div>
  </section>
))}

<style>
  .tp-form-link { font-size: 0.875rem; font-weight: 700; color: #2563eb; text-decoration: none; }
  .tp-form-link:hover { color: #1d4ed8; }
  .tp-form-note { color: #64748b; font-size: 0.8125rem; margin-top: 0.5rem; }
</style>
