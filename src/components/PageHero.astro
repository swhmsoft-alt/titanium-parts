---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  image?: string;
}
const { eyebrow, title, description, image } = Astro.props;
---
<section class={`page-hero${image ? ' page-hero-with-image' : ''}`}>
  {image && (
    <div class="page-hero-bg" aria-hidden="true">
      <img src={image} alt="" loading="eager" />
      <div class="page-hero-bg-overlay"></div>
    </div>
  )}
  <div class="container">
    <div class="page-hero-content">
      {eyebrow && <span class="page-hero-eyebrow">{eyebrow}</span>}
      <h1 class="page-hero-title">{title}</h1>
      {description && <p class="page-hero-desc">{description}</p>}
    </div>
  </div>
</section>
<style>
  .page-hero { background: linear-gradient(135deg, #0A213C 0%, #143B6B 100%); color: #fff; padding: 5rem 0 4rem; position: relative; overflow: hidden; }
  .page-hero::before { content: ''; position: absolute; inset: 0; background: radial-gradient(circle at 80% 20%, rgba(230,57,70,0.15) 0%, transparent 50%); }
  .page-hero-content { position: relative; z-index: 1; max-width: 900px; }
  .page-hero-eyebrow { display: inline-block; padding: 0.375rem 0.875rem; margin-bottom: 1rem; background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); color: #fff; font-size: 0.8125rem; font-weight: 600; border-radius: var(--radius-full); letter-spacing: 0.05em; text-transform: uppercase; }
  .page-hero-title { font-size: clamp(2rem, 4vw, 3rem); font-weight: 800; line-height: 1.1; color: #fff; margin-bottom: 1.25rem; letter-spacing: -0.02em; }
  .page-hero-desc { font-size: clamp(1rem, 1.4vw, 1.125rem); line-height: 1.6; color: rgba(255,255,255,0.9); max-width: 800px; }
  .page-hero-with-image { background: #0A213C; }
  .page-hero-bg { position: absolute; inset: 0; z-index: 0; }
  .page-hero-bg img { width: 100%; height: 100%; object-fit: cover; object-position: center; opacity: 0.5; }
  .page-hero-bg-overlay { position: absolute; inset: 0; background: linear-gradient(135deg, rgba(10,33,60,0.7) 0%, rgba(20,59,107,0.7) 100%); }
</style>
