---
/**
 * The body of the titanium grade hub page.
 *
 * The hub is the entry point of the material-driven search route. It compares
 * the nine grades, maps them onto the applications they are normally written
 * for, names the standards that carry them, and closes the loop with the two
 * electrochemical product families where the same grades reappear.
 */
import Icon from '../Icon.astro';
import RFQForm from '../RFQForm.astro';
import { grades, gradeComparisonRows, gradeHref } from '../../data/titanium-grades';
import {
  hubMeta,
  selectionRoutes,
  applicationMatrix,
  standardRows,
  hubFaqs,
} from '../../data/titanium-grades-hub';
---

<nav class="grade-breadcrumb" aria-label="Breadcrumb">
  <div class="container">
    <a href="/">Home</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">Titanium Grades</span>
  </div>
</nav>

<!-- SELECTION ROUTES ============================================ -->
<section class="grade-section grade-section-white">
  <div class="container">
    <div class="grade-section-header">
      <span class="grade-eyebrow">Two Families</span>
      <h2 class="grade-h2">Commercially Pure or Alloy — the First Split</h2>
      <p class="grade-lede">
        Almost every titanium decision starts with one question: is the driving requirement
        corrosion resistance and formability, or is it strength? Everything else — the product
        form, the welding route, the price and the lead time — follows from that answer.
      </p>
    </div>
    <div class="grade-route-grid">
      {selectionRoutes.map((route) => (
        <article class="grade-route-card">
          <span class="grade-route-label">{route.label}</span>
          <h3>{route.title}</h3>
          <p>{route.body}</p>
          <a href={route.href} class="grade-link">
            View the products <Icon name="arrow-right" size={14} />
          </a>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- COMPARISON TABLE ============================================= -->
<section class="grade-section grade-section-slate">
  <div class="container">
    <div class="grade-section-header">
      <span class="grade-eyebrow">Side by Side</span>
      <h2 class="grade-h2">The Nine Grades on One Table</h2>
      <p class="grade-lede">
        The summary numbers below are reference windows from the published standard families.
        They are enough to narrow the field; the full composition table and the standard
        reference sit on each grade page.
      </p>
    </div>
    <div class="grade-table-wrap" role="region" aria-label="Titanium grade comparison table" tabindex="0">
      <table class="grade-table">
        <caption class="grade-table-caption">
          The nine titanium grades in this library compared on designation, family and minimum
          mechanical windows. These are reference windows from the published standard families;
          the full composition table and standard reference sit on each grade page.
        </caption>
        <thead>
          <tr>
            <th scope="col">Grade</th>
            <th scope="col">Designation</th>
            <th scope="col">Family</th>
            <th scope="col">Tensile strength</th>
            <th scope="col">Elongation</th>
            <th scope="col">What decides it</th>
          </tr>
        </thead>
        <tbody>
          {gradeComparisonRows.map((row) => (
            <tr>
              <th scope="row">
                <a href={row.href} class="grade-table-link">{row.grade}</a>
              </th>
              <td>{row.designation}</td>
              <td>{row.family}</td>
              <td>{row.tensile}</td>
              <td>{row.elongation}</td>
              <td>{row.decidingProperty}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="grade-note">
      Reference windows only. The value that governs an order is the one in the standard revision
      named on the certificate, for the product form and condition being supplied.
    </p>
  </div>
</section>

<!-- GRADE CARDS ================================================== -->
<section class="grade-section grade-section-white">
  <div class="container">
    <div class="grade-section-header">
      <span class="grade-eyebrow">Grade Pages</span>
      <h2 class="grade-h2">Open a Grade for the Full Technical Sheet</h2>
      <p class="grade-lede">
        Each page carries the chemical composition table, the mechanical property table, the
        standards that write the grade, the processing routes, and the products and
        electrochemical applications the grade is normally chosen for.
      </p>
    </div>
    <div class="grade-card-grid">
      {grades.map((g) => (
        <a href={gradeHref(g.slug)} class="grade-card">
          <span class="grade-card-family">{g.family}</span>
          <h3>{g.grade}</h3>
          <p class="grade-card-designation">{g.unisteady}</p>
          <p class="grade-card-text">{g.name}</p>
          <span class="grade-card-link">Technical sheet <Icon name="arrow-right" size={14} /></span>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- REFERENCE WINDOWS ============================================ -->
<section class="grade-section grade-section-slate">
  <div class="container">
    <div class="grade-section-header">
      <span class="grade-eyebrow">How to Read a Grade</span>
      <h2 class="grade-h2">Chemical Composition and Mechanical Properties, Side by Side</h2>
      <p class="grade-lede">
        Every grade page carries two tables. The <strong>Chemical Composition</strong> table gives
        the element-by-element window the standard allows, with a note on why each element is
        controlled. The <strong>Mechanical Properties</strong> table gives the strength,
        elongation and hardness windows, with the condition each window belongs to. Both tables
        are reference windows: the value that governs an order is the one in the standard revision
        named on the certificate, for the product form and condition being supplied.
      </p>
    </div>
    <div class="grade-route-grid">
      <article class="grade-route-card">
        <span class="grade-route-label">Chemical Composition</span>
        <h3>The Chemistry Window</h3>
        <p>
          Titanium is the balance; everything else is an allowance. The interstitials — oxygen,
          nitrogen and hydrogen — move the strength and the ductility in opposite directions, and
          the alloying additions decide what family the grade belongs to. A certificate states
          the measured values; the standard states the window they are measured against.
        </p>
        <a href={gradeHref('grade-2')} class="grade-link">
          See it on Grade 2 <Icon name="arrow-right" size={14} />
        </a>
      </article>
      <article class="grade-route-card">
        <span class="grade-route-label">Mechanical Properties</span>
        <h3>The Strength and Ductility Window</h3>
        <p>
          Tensile strength, yield strength and elongation are the three numbers that decide
          whether a grade can be formed, machined, welded or used at a given load. They are
          minimums, not targets, and the minimum changes with the product form — the same grade
          in bar and in sheet does not carry the same window.
        </p>
        <a href={gradeHref('grade-5')} class="grade-link">
          See it on Grade 5 <Icon name="arrow-right" size={14} />
        </a>
      </article>
    </div>
  </div>
</section>

<!-- APPLICATION MATRIX =========================================== -->
<section class="grade-section grade-section-slate">
  <div class="container">
    <div class="grade-section-header">
      <span class="grade-eyebrow">Grade to Application</span>
      <h2 class="grade-h2">Which Grade the Duty Normally Calls For</h2>
      <p class="grade-lede">
        This is the working table most inquiries start from. It names the grade normally written
        for a duty, the grade to review when the duty is more severe than usual, and the reason
        for the choice.
      </p>
    </div>
    <div class="grade-table-wrap" role="region" aria-label="Titanium grade application matrix" tabindex="0">
      <table class="grade-table">
        <caption class="grade-table-caption">
          Application matrix: the titanium grade normally written for a duty, the grade to review
          when the duty is more severe than usual, and the reason for the choice. Confirm the
          grade against the standard revision named on the certificate before ordering.
        </caption>
        <thead>
          <tr>
            <th scope="col">Application</th>
            <th scope="col">Grade normally written</th>
            <th scope="col">Review when</th>
            <th scope="col">Why</th>
            <th scope="col">Products</th>
          </tr>
        </thead>
        <tbody>
          {applicationMatrix.map((row) => (
            <tr>
              <th scope="row">{row.application}</th>
              <td>{row.primary}</td>
              <td>{row.review}</td>
              <td>{row.reason}</td>
              <td><a href={row.href} class="grade-table-link">View</a></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<!-- STANDARDS ==================================================== -->
<section class="grade-section grade-section-white">
  <div class="container">
    <div class="grade-section-header">
      <span class="grade-eyebrow">Standards</span>
      <h2 class="grade-h2">Which Standard Carries Which Grade</h2>
      <p class="grade-lede">
        The same grade number is written differently in different standards, and the strength
        window depends on the product form as well as the standard. This table is the map from
        the grade to the document it should be ordered against.
      </p>
    </div>
    <div class="grade-table-wrap" role="region" aria-label="Titanium standards cross-reference" tabindex="0">
      <table class="grade-table">
        <caption class="grade-table-caption">
          Standards cross-reference: which standard carries which titanium grade, and what the
          revision named on the certificate governs. The revision and the product form decide the
          strength window.
        </caption>
        <thead>
          <tr>
            <th scope="col">Standard</th>
            <th scope="col">Covers</th>
            <th scope="col">Grades in this library</th>
            <th scope="col">Note</th>
          </tr>
        </thead>
        <tbody>
          {standardRows.map((row) => (
            <tr>
              <th scope="row">{row.standard}</th>
              <td>{row.covers}</td>
              <td>{row.grades}</td>
              <td>{row.note}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<!-- ELECTROCHEMICAL CROSS-LINK =================================== -->
<section class="grade-section grade-section-slate">
  <div class="container">
    <div class="grade-section-header">
      <span class="grade-eyebrow">Material into Electrochemistry</span>
      <h2 class="grade-h2">How a Grade Becomes an Anode or a Stack</h2>
      <p class="grade-lede">
        The grade library is the material half of the business. The same grades reappear inside
        the two electrochemical product families, where the selection question is different:
        the coating, the current density and the service environment decide the design, and the
        grade has to follow the design rather than lead it.
      </p>
    </div>
    <div class="grade-route-grid">
      <article class="grade-route-card">
        <span class="grade-route-label">Titanium Anodes</span>
        <h3>Substrate Choice for a Coated Electrode</h3>
        <p>
          Grade 1 for expanded mesh and formed electrode bodies, Grade 2 for rigid tubular, rod and
          plate anodes and for the current feed, Grade 7 where the electrolyte is a strongly
          reducing acid. The coating survives on the substrate that the forming route can actually
          produce.
        </p>
        <a href="/titanium-anode/" class="grade-link">
          Titanium anodes <Icon name="arrow-right" size={14} />
        </a>
      </article>
      <article class="grade-route-card">
        <span class="grade-route-label">PEM Electrolyzer</span>
        <h3>Component Choice Inside a Stack</h3>
        <p>
          Grade 1 for the porous transport layer and the platinised anode-side components, Grade 2
          for the bipolar plate, the end plate and the structural parts. In the acidic, high
          potential anode compartment, the base metal must not release ions into the membrane.
        </p>
        <a href="/pem-electrolyzer/" class="grade-link">
          PEM electrolyzers <Icon name="arrow-right" size={14} />
        </a>
      </article>
    </div>
  </div>
</section>

<!-- FAQ =========================================================== -->
<section id="faq" class="grade-section grade-section-white">
  <div class="container">
    <div class="grade-section-header">
      <span class="grade-eyebrow">Questions</span>
      <h2 class="grade-h2">Titanium Grade Questions, Answered</h2>
      <p class="grade-lede">
        The questions that decide a grade, answered with the reasoning rather than with a feature
        list.
      </p>
    </div>
    <div class="grade-faq">
      {hubFaqs.map((item) => (
        <details class="grade-faq-item">
          <summary class="grade-faq-question">
            <span>{item.question}</span>
            <span class="grade-faq-mark" aria-hidden="true">
              <Icon name="plus" size={16} />
            </span>
          </summary>
          <div class="grade-faq-answer">
            <p>{item.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<!-- RFQ =========================================================== -->
<section id="rfq" class="grade-section grade-section-slate">
  <div class="container">
    <div class="grade-section-header">
      <span class="grade-eyebrow">Material Inquiry</span>
      <h2 class="grade-h2">Send the Grade, the Form and the Duty</h2>
      <p class="grade-lede">
        A quotation for titanium material starts with the grade, the product form, the dimensions
        and the service. Give us those and we confirm availability, the standard revision, the
        certificate scope and the inspection plan — and tell you plainly if a different grade is
        the better answer.
      </p>
    </div>
    <div class="grade-rfq">
      <RFQForm
        variant="titanium"
        title="Request a Titanium Grade Quotation"
        subtitle="We confirm grade availability, standard revision and certificate scope within one business day."
      />
    </div>
  </div>
</section>

<style>
  .grade-section { padding: 4.5rem 0; }
  .grade-section-white { background: #fff; }
  .grade-section-slate { background: var(--color-slate-50); }
  .grade-section-header { max-width: 820px; margin-bottom: 2.5rem; }
  .grade-eyebrow {
    display: inline-block; padding: 0.3125rem 0.75rem; margin-bottom: 0.875rem;
    background: var(--color-primary-50); color: var(--color-primary-700);
    font-size: 0.75rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
    border-radius: 999px;
  }
  .grade-h2 {
    font-size: clamp(1.5rem, 2.6vw, 2.125rem); font-weight: 800; line-height: 1.2;
    color: var(--color-heading); margin-bottom: 0.875rem; letter-spacing: -0.015em;
  }
  .grade-lede { font-size: 1.0625rem; line-height: 1.75; color: var(--color-text-secondary); margin: 0; }
  .grade-note {
    margin-top: 1rem; font-size: 0.875rem; line-height: 1.65; color: var(--color-text-muted);
    max-width: 900px;
  }

  .grade-breadcrumb { background: var(--color-slate-50); border-bottom: 1px solid var(--color-border); font-size: 0.875rem; }
  .grade-breadcrumb .container { display: flex; gap: 0.5rem; padding: 0.75rem 1.25rem; }
  .grade-breadcrumb a { color: var(--color-primary-700); text-decoration: none; }
  .grade-breadcrumb a:hover { text-decoration: underline; }
  .grade-breadcrumb span { color: var(--color-text-muted); }

  .grade-route-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; }
  @media (max-width: 860px) { .grade-route-grid { grid-template-columns: 1fr; } }
  .grade-route-card {
    background: #fff; border: 1px solid var(--color-border); border-radius: var(--radius-lg);
    padding: 2rem;
  }
  .grade-route-label {
    display: inline-block; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--color-primary-700); margin-bottom: 0.625rem;
  }
  .grade-route-card h3 { font-size: 1.25rem; font-weight: 700; color: var(--color-heading); margin-bottom: 0.75rem; }
  .grade-route-card p { font-size: 0.9375rem; line-height: 1.75; color: var(--color-text-secondary); margin-bottom: 1.25rem; }
  .grade-link {
    display: inline-flex; align-items: center; gap: 0.375rem; font-size: 0.9375rem; font-weight: 600;
    color: var(--color-primary-700); text-decoration: none;
  }
  .grade-link:hover { text-decoration: underline; }
  .grade-link :global(svg) { color: var(--color-primary); }

  .grade-table-wrap { overflow-x: auto; border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: #fff; }
  .grade-table { width: 100%; border-collapse: collapse; font-size: 0.9375rem; }
  .grade-table th {
    background: var(--color-slate-900); color: #fff; padding: 0.875rem 1.125rem; text-align: left;
    font-size: 0.8125rem; font-weight: 700; white-space: nowrap;
  }
  .grade-table td { padding: 0.9375rem 1.125rem; border-bottom: 1px solid var(--color-slate-200); vertical-align: top; line-height: 1.6; color: var(--color-text-secondary); }
  .grade-table tbody tr:last-child td { border-bottom: none; }
  .grade-table tbody tr:nth-child(even) { background: var(--color-slate-50); }
  .grade-table-caption {
    caption-side: top;
    padding: 0.875rem 1.125rem;
    text-align: left;
    font-size: 0.8125rem;
    font-weight: 700;
    line-height: 1.6;
    color: var(--color-text-secondary);
    border-bottom: 1px solid var(--color-border);
  }
  .grade-table tbody th {
    padding: 0.9375rem 1.125rem;
    border-bottom: 1px solid var(--color-slate-200);
    vertical-align: top;
    line-height: 1.6;
    text-align: left;
    font-size: 0.9375rem;
    font-weight: 700;
    white-space: normal;
    color: var(--color-text-secondary);
    background: transparent;
  }
  .grade-table tbody tr:last-child th { border-bottom: none; }
  .grade-table-link { color: var(--color-primary-700); font-weight: 600; text-decoration: none; }
  .grade-table-link:hover { text-decoration: underline; }

  .grade-card-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  @media (max-width: 1024px) { .grade-card-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .grade-card-grid { grid-template-columns: 1fr; } }
  .grade-card {
    display: block; background: #fff; border: 1px solid var(--color-border); border-radius: var(--radius-lg);
    padding: 1.625rem; text-decoration: none; transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
  }
  .grade-card:hover { border-color: var(--color-primary); transform: translateY(-2px); box-shadow: var(--shadow-md); }
  .grade-card-family {
    display: inline-block; font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--color-primary-700); margin-bottom: 0.5rem;
  }
  .grade-card h3 { font-size: 1.25rem; font-weight: 700; color: var(--color-heading); margin-bottom: 0.25rem; }
  .grade-card-designation { font-size: 0.875rem; font-weight: 600; color: var(--color-text-muted); margin-bottom: 0.625rem; }
  .grade-card-text { font-size: 0.9375rem; line-height: 1.65; color: var(--color-text-secondary); margin-bottom: 1rem; }
  .grade-card-link {
    display: inline-flex; align-items: center; gap: 0.375rem; font-size: 0.875rem; font-weight: 600;
    color: var(--color-primary-700);
  }
  .grade-card-link :global(svg) { color: var(--color-primary); }

  .grade-faq { display: flex; flex-direction: column; gap: 0.75rem; max-width: 900px; }
  .grade-faq-item { background: #fff; border: 1px solid var(--color-border); border-radius: var(--radius-lg); overflow: hidden; }
  .grade-faq-item[open] { border-color: var(--color-primary-200); box-shadow: 0 6px 20px -12px rgba(15, 23, 42, 0.25); }
  .grade-faq-question {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    padding: 1.125rem 1.5rem; cursor: pointer; font-size: 1rem; font-weight: 600;
    color: var(--color-heading); list-style: none;
  }
  .grade-faq-question::-webkit-details-marker { display: none; }
  .grade-faq-mark { flex-shrink: 0; display: inline-flex; color: var(--color-primary); }
  .grade-faq-answer { padding: 0 1.5rem 1.375rem; border-top: 1px solid var(--color-slate-100); }
  .grade-faq-answer p { margin: 0; padding-top: 0.9375rem; font-size: 0.9375rem; line-height: 1.75; color: var(--color-text-secondary); }

  .grade-rfq { max-width: 900px; }
</style>
