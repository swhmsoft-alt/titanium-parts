---
/**
 * The body of one titanium grade technical page.
 *
 * Every grade page is the same structure rendered from one grade record: the
 * chemistry window, the mechanical window, the standards that carry the
 * grade, the processing routes, the products made from it, and the two
 * electrochemical applications where the grade does or does not have a role.
 */
import Icon from '../Icon.astro';
import RFQForm from '../RFQForm.astro';
import type { GradeSpec } from '../../data/titanium-grades';
import { grades, gradeHref } from '../../data/titanium-grades';

interface Props {
  /** The grade this page describes. */
  grade: GradeSpec;
}

const { grade } = Astro.props;

/** The other grades, so the reader can move sideways instead of back. */
const siblings = grades.filter((g) => g.slug !== grade.slug);
---

<nav class="grade-breadcrumb" aria-label="Breadcrumb">
  <div class="container">
    <a href="/">Home</a>
    <span aria-hidden="true">/</span>
    <a href="/titanium-grades/">Titanium Grades</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{grade.grade}</span>
  </div>
</nav>

<!-- GRADE OVERVIEW =============================================== -->
<section class="grade-section grade-section-white">
  <div class="container">
    <div class="grade-overview">
      <div class="grade-overview-lead">
        <span class="grade-eyebrow">{grade.family} Grade</span>
        <h2 class="grade-h2">{grade.grade} — {grade.unisteady}</h2>
        <p class="grade-lede">{grade.intro}</p>
        <p class="grade-note">
          The figures on this page are reference windows drawn from the published standard
          families. The value that governs an order is the one in the standard revision named on
          the certificate, for the product form and condition being supplied.
        </p>
      </div>
      <dl class="grade-facts">
        <div class="grade-fact">
          <dt>Commercial grade</dt>
          <dd>{grade.grade}</dd>
        </div>
        <div class="grade-fact">
          <dt>Mill designation</dt>
          <dd>{grade.unisteady}</dd>
        </div>
        <div class="grade-fact">
          <dt>Material family</dt>
          <dd>{grade.family}</dd>
        </div>
        <div class="grade-fact">
          <dt>Grade sheet</dt>
          <dd><a href={gradeHref(grade.slug)}>{grade.grade} technical page</a></dd>
        </div>
      </dl>
    </div>
  </div>
</section>

<!-- CHEMICAL COMPOSITION ========================================= -->
<section class="grade-section grade-section-slate">
  <div class="container">
    <div class="grade-section-header">
      <span class="grade-eyebrow">Chemical Composition</span>
      <h2 class="grade-h2">What {grade.grade} Is Made Of</h2>
      <p class="grade-lede">
        Titanium is the balance and every other element is an allowance. The interstitials move
        strength and ductility in opposite directions, and the alloying additions decide what
        family the grade belongs to.
      </p>
    </div>
    <div class="grade-table-wrap" role="region" aria-label={`${grade.grade} chemical composition`} tabindex="0">
      <table class="grade-table">
        <caption class="grade-table-caption">
          Chemical composition window for {grade.grade}, in mass percent unless the cell states
          otherwise. The measured composition on the certificate is the one that governs.
        </caption>
        <thead>
          <tr>
            <th scope="col">Element</th>
            <th scope="col">Minimum</th>
            <th scope="col">Maximum</th>
            <th scope="col">What it controls</th>
          </tr>
        </thead>
        <tbody>
          {grade.chemistry.map((row) => (
            <tr>
              <th scope="row">{row.element}</th>
              <td>{row.min ?? '—'}</td>
              <td>{row.max ?? '—'}</td>
              <td>{row.note ?? '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="grade-note">
      Reference window only. The measured composition on the certificate is the one that governs.
    </p>
  </div>
</section>

<!-- MECHANICAL PROPERTIES ======================================= -->
<section class="grade-section grade-section-white">
  <div class="container">
    <div class="grade-section-header">
      <span class="grade-eyebrow">Mechanical Properties</span>
      <h2 class="grade-h2">What {grade.grade} Does Under Load</h2>
      <p class="grade-lede">
        These are minimums, not targets, and the minimum depends on the product form as well as
        the standard. The window below belongs to the annealed condition named in the row.
      </p>
    </div>
    <div class="grade-table-wrap" role="region" aria-label={`${grade.grade} mechanical properties`} tabindex="0">
      <table class="grade-table">
        <caption class="grade-table-caption">
          Mechanical property reference window for {grade.grade}. These are minimums in the
          annealed condition; the minimum that governs an order is the one in the standard
          revision named on the certificate, for the product form being supplied.
        </caption>
        <thead>
          <tr>
            <th scope="col">Property</th>
            <th scope="col">Reference window</th>
            <th scope="col">Condition</th>
          </tr>
        </thead>
        <tbody>
          {grade.mechanical.map((row) => (
            <tr>
              <th scope="row">{row.property}</th>
              <td>{row.value}</td>
              <td>{row.note ?? '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<!-- STANDARDS, PROCESSING, APPLICATIONS =========================== -->
<section class="grade-section grade-section-slate">
  <div class="container">
    <div class="grade-three">
      <article class="grade-route-card">
        <span class="grade-route-label">Standards</span>
        <h3>Where {grade.grade} Is Written Down</h3>
        <ul class="grade-list">
          {grade.standards.map((s) => <li>{s}</li>)}
        </ul>
        <p class="grade-route-card-note">
          The revision named on the certificate is the one that governs, and the European number
          is not always interchangeable with the ASTM grade.
        </p>
      </article>
      <article class="grade-route-card">
        <span class="grade-route-label">Processing</span>
        <h3>How {grade.grade} Is Normally Worked</h3>
        <ul class="grade-list">
          {grade.processing.map((s) => <li>{s}</li>)}
        </ul>
      </article>
      <article class="grade-route-card">
        <span class="grade-route-label">Applications</span>
        <h3>Where {grade.grade} Is Normally Used</h3>
        <ul class="grade-list">
          {grade.applications.map((s) => <li>{s}</li>)}
        </ul>
      </article>
    </div>
  </div>
</section>

<!-- PRODUCT LINKS ================================================ -->
<section class="grade-section grade-section-white">
  <div class="container">
    <div class="grade-section-header">
      <span class="grade-eyebrow">Products in {grade.grade}</span>
      <h2 class="grade-h2">What We Make From {grade.grade}</h2>
      <p class="grade-lede">
        These are the product forms normally supplied in this grade, and the reason the form and
        the grade meet each other.
      </p>
    </div>
    <div class="grade-product-grid">
      {grade.productLinks.map((p) => (
        <a href={p.href} class="grade-product-card">
          <h3>{p.label}</h3>
          <p>{p.note}</p>
          <span class="grade-card-link">View product <Icon name="arrow-right" size={14} /></span>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- ELECTROCHEMICAL ROLE ======================================== -->
<section class="grade-section grade-section-slate">
  <div class="container">
    <div class="grade-section-header">
      <span class="grade-eyebrow">In Electrochemistry</span>
      <h2 class="grade-h2">Where {grade.grade} Appears in an Anode or a Stack</h2>
      <p class="grade-lede">
        The grade library is the material half of the business. In the two electrochemical product
        families the selection question runs the other way: the coating, the current density and
        the service environment decide the design, and the grade has to follow the design.
      </p>
    </div>
    <div class="grade-route-grid">
      <article class="grade-route-card">
        <span class="grade-route-label">Titanium Anode Substrate</span>
        <h3>{grade.grade} as a Coated Electrode Base</h3>
        <p>{grade.anodeUse}</p>
        <a href="/titanium-anode/" class="grade-link">
          Titanium anodes <Icon name="arrow-right" size={14} />
        </a>
      </article>
      <article class="grade-route-card">
        <span class="grade-route-label">PEM Electrolyzer Components</span>
        <h3>{grade.grade} Inside a Stack</h3>
        <p>{grade.pemUse}</p>
        <a href="/pem-electrolyzer/" class="grade-link">
          PEM electrolyzers <Icon name="arrow-right" size={14} />
        </a>
      </article>
    </div>
  </div>
</section>

<!-- OTHER GRADES ================================================= -->
<section class="grade-section grade-section-white">
  <div class="container">
    <div class="grade-section-header">
      <span class="grade-eyebrow">Compare</span>
      <h2 class="grade-h2">The Other Grades</h2>
      <p class="grade-lede">
        A grade is decided against the alternatives. These are the other grades in the library.
      </p>
    </div>
    <div class="grade-sibling-grid">
      {siblings.map((g) => (
        <a href={gradeHref(g.slug)} class="grade-sibling">
          <span class="grade-sibling-family">{g.family}</span>
          <h3>{g.grade}</h3>
          <p>{g.unisteady}</p>
        </a>
      ))}
    </div>
    <p class="grade-note">
      Looking for the side-by-side numbers instead? The
      <a href="/titanium-grades/">titanium grades overview</a> carries the full comparison table.
    </p>
  </div>
</section>

<!-- RFQ =========================================================== -->
<section id="rfq" class="grade-section grade-section-slate">
  <div class="container">
    <div class="grade-section-header">
      <span class="grade-eyebrow">Material Inquiry</span>
      <h2 class="grade-h2">Send {grade.grade} With the Form and the Duty</h2>
      <p class="grade-lede">
        Tell us the grade, the product form, the dimensions and the service, and we confirm
        availability, the standard revision, the certificate scope and the inspection plan — and
        tell you plainly if a different grade is the better answer.
      </p>
    </div>
    <div class="grade-rfq">
      <RFQForm
        variant="titanium"
        title={`Request a ${grade.grade} Quotation`}
        subtitle="We confirm grade availability, standard revision and certificate scope within one business day."
      />
    </div>
  </div>
</section>

<style>
  .grade-section { padding: 4.5rem 0; }
  .grade-section-white { background: #fff; }
  .grade-section-slate { background: var(--color-slate-50); }
  .grade-section-header { max-width: 820px; margin-bottom: 2.5rem; }
  .grade-eyebrow {
    display: inline-block; padding: 0.3125rem 0.75rem; margin-bottom: 0.875rem;
    background: var(--color-primary-50); color: var(--color-primary-700);
    font-size: 0.75rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
    border-radius: 999px;
  }
  .grade-h2 {
    font-size: clamp(1.5rem, 2.6vw, 2.125rem); font-weight: 800; line-height: 1.2;
    color: var(--color-heading); margin-bottom: 0.875rem; letter-spacing: -0.015em;
  }
  .grade-lede { font-size: 1.0625rem; line-height: 1.75; color: var(--color-text-secondary); margin: 0; }
  .grade-note {
    margin-top: 1rem; font-size: 0.875rem; line-height: 1.65; color: var(--color-text-muted);
    max-width: 900px;
  }
  .grade-note a { color: var(--color-primary-700); }

  .grade-breadcrumb { background: var(--color-slate-50); border-bottom: 1px solid var(--color-border); font-size: 0.875rem; }
  .grade-breadcrumb .container { display: flex; gap: 0.5rem; padding: 0.75rem 1.25rem; flex-wrap: wrap; }
  .grade-breadcrumb a { color: var(--color-primary-700); text-decoration: none; }
  .grade-breadcrumb a:hover { text-decoration: underline; }
  .grade-breadcrumb span { color: var(--color-text-muted); }

  .grade-overview { display: grid; grid-template-columns: 1.4fr 1fr; gap: 3rem; align-items: start; }
  @media (max-width: 900px) { .grade-overview { grid-template-columns: 1fr; gap: 2rem; } }
  .grade-facts { display: flex; flex-direction: column; gap: 0.75rem; margin: 0; }
  .grade-fact { background: #fff; border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: 1rem 1.25rem; }
  .grade-fact dt { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-text-muted); margin-bottom: 0.25rem; }
  .grade-fact dd { margin: 0; font-size: 1rem; font-weight: 600; color: var(--color-heading); }
  .grade-fact dd a { color: var(--color-primary-700); text-decoration: none; }
  .grade-fact dd a:hover { text-decoration: underline; }

  .grade-table-wrap { overflow-x: auto; border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: #fff; }
  .grade-table { width: 100%; border-collapse: collapse; font-size: 0.9375rem; }
  .grade-table th {
    background: var(--color-slate-900); color: #fff; padding: 0.875rem 1.125rem; text-align: left;
    font-size: 0.8125rem; font-weight: 700; white-space: nowrap;
  }
  .grade-table td { padding: 0.9375rem 1.125rem; border-bottom: 1px solid var(--color-slate-200); vertical-align: top; line-height: 1.6; color: var(--color-text-secondary); }
  .grade-table tbody tr:last-child td { border-bottom: none; }
  .grade-table tbody tr:nth-child(even) { background: var(--color-slate-50); }
  .grade-table-caption {
    caption-side: top;
    padding: 0.875rem 1.125rem;
    text-align: left;
    font-size: 0.8125rem;
    font-weight: 700;
    line-height: 1.6;
    color: var(--color-text-secondary);
    border-bottom: 1px solid var(--color-border);
  }
  .grade-table tbody th {
    padding: 0.9375rem 1.125rem;
    border-bottom: 1px solid var(--color-slate-200);
    vertical-align: top;
    line-height: 1.6;
    text-align: left;
    font-size: 0.9375rem;
    font-weight: 700;
    white-space: normal;
    color: var(--color-text-secondary);
    background: transparent;
  }
  .grade-table tbody tr:last-child th { border-bottom: none; }

  .grade-three { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
  @media (max-width: 960px) { .grade-three { grid-template-columns: 1fr; } }
  .grade-route-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; }
  @media (max-width: 860px) { .grade-route-grid { grid-template-columns: 1fr; } }
  .grade-route-card { background: #fff; border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: 1.75rem; }
  .grade-route-label {
    display: inline-block; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--color-primary-700); margin-bottom: 0.625rem;
  }
  .grade-route-card h3 { font-size: 1.1875rem; font-weight: 700; color: var(--color-heading); margin-bottom: 0.875rem; }
  .grade-route-card p { font-size: 0.9375rem; line-height: 1.75; color: var(--color-text-secondary); margin-bottom: 1.25rem; }
  .grade-route-card-note { font-size: 0.8125rem !important; color: var(--color-text-muted) !important; margin-bottom: 0 !important; }
  .grade-list { list-style: none; padding: 0; margin: 0 0 1rem; display: flex; flex-direction: column; gap: 0.625rem; }
  .grade-list li { position: relative; padding-left: 1.25rem; font-size: 0.9375rem; line-height: 1.65; color: var(--color-text-secondary); }
  .grade-list li::before { content: ''; position: absolute; left: 0; top: 0.6rem; width: 0.375rem; height: 0.375rem; border-radius: 50%; background: var(--color-primary); }
  .grade-link { display: inline-flex; align-items: center; gap: 0.375rem; font-size: 0.9375rem; font-weight: 600; color: var(--color-primary-700); text-decoration: none; }
  .grade-link:hover { text-decoration: underline; }
  .grade-link :global(svg) { color: var(--color-primary); }

  .grade-product-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.25rem; }
  @media (max-width: 860px) { .grade-product-grid { grid-template-columns: 1fr; } }
  .grade-product-card {
    display: block; background: #fff; border: 1px solid var(--color-border); border-radius: var(--radius-lg);
    padding: 1.5rem; text-decoration: none; transition: border-color 0.2s, transform 0.2s;
  }
  .grade-product-card:hover { border-color: var(--color-primary); transform: translateY(-2px); }
  .grade-product-card h3 { font-size: 1.0625rem; font-weight: 700; color: var(--color-heading); margin-bottom: 0.5rem; }
  .grade-product-card p { font-size: 0.9375rem; line-height: 1.7; color: var(--color-text-secondary); margin-bottom: 1rem; }
  .grade-card-link { display: inline-flex; align-items: center; gap: 0.375rem; font-size: 0.875rem; font-weight: 600; color: var(--color-primary-700); }
  .grade-card-link :global(svg) { color: var(--color-primary); }

  .grade-sibling-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
  @media (max-width: 960px) { .grade-sibling-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 520px) { .grade-sibling-grid { grid-template-columns: 1fr; } }
  .grade-sibling {
    display: block; background: #fff; border: 1px solid var(--color-border); border-radius: var(--radius-lg);
    padding: 1.25rem; text-decoration: none; transition: border-color 0.2s;
  }
  .grade-sibling:hover { border-color: var(--color-primary); }
  .grade-sibling-family { display: block; font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-primary-700); margin-bottom: 0.375rem; }
  .grade-sibling h3 { font-size: 1.0625rem; font-weight: 700; color: var(--color-heading); margin-bottom: 0.25rem; }
  .grade-sibling p { font-size: 0.875rem; color: var(--color-text-muted); margin: 0; }

  .grade-rfq { max-width: 900px; }
</style>
