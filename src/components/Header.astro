---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { company } from '@data/company';

import { mainNav, filterAvailable } from '@data/navigation';
import routes from '@data/routes.json';

// Only surface menu entries whose target page exists in the build.
const navItems = filterAvailable(
  mainNav,
  new Set(routes as string[])
);

const currentPath = Astro.url.pathname;
---

<header class="site-header" id="site-header">
  <div class="header-top">
    <div class="container">
      <div class="header-top-inner">
        <div class="header-top-left">
          <a href={`tel:${company.contact.phone.replace(/\s/g,'')}`} class="header-top-link">
            <Icon name="phone-call" size={14} />
            <span>{company.contact.phoneDisplay}</span>
          </a>
          <a href={`mailto:${company.contact.salesEmail}`} class="header-top-link">
            <Icon name="mail" size={14} />
            <span>{company.contact.salesEmail}</span>
          </a>
        </div>
        <div class="header-top-right">
          <span class="header-top-badge">
            <Icon name="check-circle" size={14} />
            Direct Factory · Engineering Supplier
          </span>
        </div>
      </div>
    </div>
  </div>

  <div class="header-main">
    <div class="container">
      <div class="header-main-inner">
        <Logo />
        <nav class="main-nav" aria-label="Main navigation">
          <ul class="main-nav-list">
            {navItems.map((item) => (
              <li class={`main-nav-item ${item.children ? 'has-dropdown' : ''}`}>
                {item.children ? (
                  <>
                    <a href={item.href} class="main-nav-link">
                      {item.label}
                      <Icon name="chevron-down" size={14} className="nav-chevron" />
                    </a>
                    <div class={`mega-menu ${item.label === 'Titanium Anodes' ? 'mega-menu-wide' : ''}`}>
                      <div class="container">
                        <div class="mega-menu-grid">
                          {item.children.map((child) => (
                            child.children ? (
                              <div class="mega-menu-group">
                                <a href={child.href} class={`mega-menu-group-label ${currentPath === child.href ? 'is-active' : ''}`}>
                                  {child.label}
                                  <Icon name="chevron-right" size={12} />
                                </a>
                                <div class="mega-menu-sub">
                                  {child.children.map((sub) => (
                                    <a href={sub.href} class={`mega-menu-sub-item ${currentPath === sub.href ? 'is-active' : ''}`}>
                                      {sub.label}
                                    </a>
                                  ))}
                                </div>
                              </div>
                            ) : (
                              <a href={child.href} class={`mega-menu-item ${currentPath === child.href ? 'is-active' : ''}`}>
                                <span class="mega-menu-item-label">{child.label}</span>
                                {child.description && <span class="mega-menu-item-desc">{child.description}</span>}
                              </a>
                            )
                          ))}
                        </div>
                      </div>
                    </div>
                  </>
                ) : (
                  <a href={item.href} class={`main-nav-link ${currentPath === item.href ? 'is-active' : ''}`}>
                    {item.label}
                  </a>
                )}
              </li>
            ))}
          </ul>
        </nav>
        <div class="header-actions">
          <a href="/contact/" class="btn btn-primary btn-sm header-cta">Get a Quote</a>
          <button class="mobile-menu-toggle" id="mobile-menu-toggle" aria-label="Open menu">
            <Icon name="menu" size={24} />
          </button>
        </div>
      </div>
    </div>
  </div>
</header>

<div class="mobile-menu" id="mobile-menu" aria-hidden="true">
  <div class="mobile-menu-header">
    <Logo />
    <button class="mobile-menu-close" id="mobile-menu-close" aria-label="Close menu">
      <Icon name="close" size={24} />
    </button>
  </div>
  <nav class="mobile-menu-nav">
    <ul>
      {navItems.map((item) => (
        <li class="mobile-menu-item">
          {item.children ? (
            <details>
              <summary class="mobile-menu-link">
                {item.label}
                <Icon name="plus" size={16} />
              </summary>
              <ul class="mobile-menu-sub">
                {item.children.map((child) => (
                  child.children ? (
                    <li>
                      <details>
                        <summary class="mobile-menu-sub-link mobile-menu-sub-link-nested">
                          {child.label}
                          <Icon name="plus" size={14} />
                        </summary>
                        <ul class="mobile-menu-sub-sub">
                          {child.children.map((sub) => (
                            <li><a href={sub.href} class="mobile-menu-sub-sub-link">{sub.label}</a></li>
                          ))}
                        </ul>
                      </details>
                    </li>
                  ) : (
                    <li><a href={child.href} class="mobile-menu-sub-link">{child.label}</a></li>
                  )
                ))}
              </ul>
            </details>
          ) : (
            <a href={item.href} class="mobile-menu-link">{item.label}</a>
          )}
        </li>
      ))}
    </ul>
  </nav>
  <div class="mobile-menu-footer">
    <a href="/contact/" class="btn btn-primary btn-block">Get a Quote</a>
    <a href={`tel:${company.contact.phone.replace(/\s/g,'')}`} class="mobile-menu-contact">
      <Icon name="phone" size={18} /> {company.contact.phoneDisplay}
    </a>
    <a href={`mailto:${company.contact.salesEmail}`} class="mobile-menu-contact">
      <Icon name="mail" size={18} /> {company.contact.salesEmail}
    </a>
  </div>
</div>

<script>
  const header = document.getElementById('site-header');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) header?.classList.add('is-scrolled');
    else header?.classList.remove('is-scrolled');
  });
  const toggle = document.getElementById('mobile-menu-toggle');
  const close = document.getElementById('mobile-menu-close');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => { menu?.classList.add('is-open'); document.body.style.overflow = 'hidden'; });
  close?.addEventListener('click', () => { menu?.classList.remove('is-open'); document.body.style.overflow = ''; });
</script>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; background: rgba(255,255,255,0.95); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); border-bottom: 1px solid #f1f5f9; font-family: inherit; }
  .header-top { background: #0f172a; color: rgba(255,255,255,0.85); font-size: 0.8125rem; }
  .header-top-inner { display: flex; justify-content: space-between; align-items: center; padding: 0.5rem 0; gap: 1rem; }
  .header-top-left { display: flex; gap: 1.5rem; }
  .header-top-link { display: inline-flex; align-items: center; gap: 0.375rem; color: rgba(255,255,255,0.85); transition: color 0.2s; }
  .header-top-link:hover { color: #fff; }
  .header-top-right { display: flex; align-items: center; }
  .header-top-badge { display: inline-flex; align-items: center; gap: 0.375rem; color: rgba(255,255,255,0.85); }
  @media (max-width: 768px) { .header-top { display: none; } }
  .header-main { background: transparent; }
  .header-main-inner { display: flex; justify-content: space-between; align-items: center; padding: 1rem 0; gap: 1.5rem; }
  .main-nav { flex: 1; display: flex; justify-content: center; }
  .main-nav-list { display: flex; gap: 0.25rem; align-items: center; }
  .main-nav-item { position: relative; }
  /* 导航紧凑排布（14px / 10px 内边距），为宽幅品牌标识留出横向空间 */
  .main-nav-link {
    display: inline-flex; align-items: center; gap: 0.25rem;
    padding: 0.5rem 0.5rem;
    font-size: 0.875rem; font-weight: 600; color: var(--color-heading);
    border-radius: var(--radius); transition: all 0.2s;
    white-space: nowrap;
  }
  .main-nav-link:hover { color: var(--color-primary); background: var(--color-primary-50); }
  .main-nav-link.is-active { color: var(--color-primary); }
  .nav-chevron { transition: transform 0.2s; }
  .has-dropdown:hover .nav-chevron { transform: rotate(180deg); }
  /* Mega menu */
  .mega-menu {
    position: absolute; top: 100%; left: 50%; transform: translateX(-50%) translateY(8px);
    min-width: 720px; max-width: 900px;
    background: #fff; border: 1px solid var(--color-border);
    border-top: 3px solid var(--color-primary);
    border-radius: 0 0 var(--radius-lg) var(--radius-lg);
    box-shadow: 0 20px 40px rgba(0,0,0,0.1);
    opacity: 0; visibility: hidden; pointer-events: none;
    transition: all 0.2s; padding: 1.5rem 0;
  }
  .has-dropdown:hover .mega-menu { opacity: 1; visibility: visible; pointer-events: auto; transform: translateX(-50%) translateY(0); }
  .mega-menu-wide { min-width: 1100px; max-width: 1280px; }
  .mega-menu-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.5rem; }
  .mega-menu-wide .mega-menu-grid { grid-template-columns: repeat(4, 1fr); gap: 1.25rem; }
  .mega-menu-item {
    display: flex; flex-direction: column; gap: 0.25rem;
    padding: 0.75rem 1rem; border-radius: var(--radius);
    transition: all 0.15s; color: var(--color-text);
  }
  .mega-menu-item:hover { background: var(--color-primary-50); color: var(--color-primary); }
  .mega-menu-item.is-active { background: var(--color-primary-50); color: var(--color-primary); }
  .mega-menu-item-label { font-weight: 600; font-size: 0.9375rem; }
  .mega-menu-item-desc { font-size: 0.8125rem; color: var(--color-text-muted); }
  /* Nested mega-menu (e.g. Titanium Anodes) */
  .mega-menu-group { display: flex; flex-direction: column; gap: 0.375rem; padding: 0.5rem; border-radius: var(--radius); }
  .mega-menu-group-label {
    display: flex; align-items: center; justify-content: space-between; gap: 0.5rem;
    padding: 0.5rem 0.75rem; font-weight: 700; font-size: 0.875rem;
    color: var(--color-heading); border-bottom: 1px solid var(--color-border);
    border-radius: 4px; transition: all 0.15s; text-decoration: none;
  }
  .mega-menu-group-label:hover { color: var(--color-primary); background: var(--color-primary-50); }
  .mega-menu-group-label.is-active { color: var(--color-primary); background: var(--color-primary-50); }
  .mega-menu-group-label :global(svg) { opacity: 0.5; flex-shrink: 0; }
  .mega-menu-group-label:hover :global(svg) { opacity: 1; }
  .mega-menu-sub { display: flex; flex-direction: column; gap: 0.125rem; padding-left: 0.5rem; }
  .mega-menu-sub-item {
    display: block; padding: 0.5rem 0.75rem; font-size: 0.8125rem;
    color: var(--color-text-secondary); border-radius: 4px;
    transition: all 0.15s; text-decoration: none; line-height: 1.45;
  }
  .mega-menu-sub-item:hover { color: var(--color-primary); background: var(--color-primary-50); }
  .mega-menu-sub-item.is-active { color: var(--color-primary); background: var(--color-primary-50); font-weight: 600; }
  .header-actions { display: flex; align-items: center; gap: 0.75rem; }
  .mobile-menu-toggle { display: none; padding: 0.5rem; color: var(--color-heading); }
  /* 品牌标识改为宽幅 SVG 锁定后，导航在 1280px 以下折叠为抽屉菜单，
     确保 logo 始终按设计尺寸呈现（40px 高 / 225px 宽）而不被挤压。 */
  @media (max-width: 1279px) {
    .main-nav { display: none; }
    .mobile-menu-toggle { display: flex; align-items: center; }
  }
  @media (max-width: 1024px) {
    .header-cta { display: none; }
  }
  .mobile-menu {
    position: fixed; inset: 0; background: #fff; z-index: var(--z-modal);
    overflow-y: auto; transform: translateX(100%); transition: transform 0.3s ease;
    display: flex; flex-direction: column;
  }
  .mobile-menu.is-open { transform: translateX(0); }
  .mobile-menu-header { display: flex; justify-content: space-between; align-items: center; padding: 1rem 1.5rem; border-bottom: 1px solid var(--color-border); }
  .mobile-menu-close { padding: 0.5rem; color: var(--color-heading); }
  .mobile-menu-nav { flex: 1; padding: 1rem 0; }
  .mobile-menu-item { border-bottom: 1px solid var(--color-border-light); }
  .mobile-menu-link {
    display: flex; justify-content: space-between; align-items: center;
    padding: 1rem 1.5rem; font-weight: 600; color: var(--color-heading);
    cursor: pointer; list-style: none;
  }
  .mobile-menu-link::-webkit-details-marker { display: none; }
  .mobile-menu-link:hover { color: var(--color-primary); }
  .mobile-menu-sub { background: var(--color-bg-light); padding: 0.5rem 0; }
  .mobile-menu-sub-link { display: block; padding: 0.625rem 2.5rem; color: var(--color-text-secondary); font-size: 0.9375rem; }
  .mobile-menu-sub-link:hover { color: var(--color-primary); background: rgba(27,77,137,0.04); }
  .mobile-menu-sub-link-nested { padding: 0.625rem 2.5rem; font-weight: 600; color: var(--color-heading); display: flex; align-items: center; justify-content: space-between; }
  .mobile-menu-sub-sub { background: #fff; border-top: 1px solid var(--color-border-light); }
  .mobile-menu-sub-sub-link { display: block; padding: 0.5rem 3.5rem; color: var(--color-text-secondary); font-size: 0.875rem; }
  .mobile-menu-sub-sub-link:hover { color: var(--color-primary); }
  .mobile-menu-footer { padding: 1.5rem; display: flex; flex-direction: column; gap: 0.75rem; border-top: 1px solid var(--color-border); }
  .mobile-menu-contact { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--color-text-secondary); font-size: 0.9375rem; }
  .mobile-menu-contact:hover { color: var(--color-primary); }
  .site-header.is-scrolled { box-shadow: 0 4px 20px rgba(0,0,0,0.08); }
  .site-header.is-scrolled .header-main-inner { padding: 0.5rem 0; }
</style>
