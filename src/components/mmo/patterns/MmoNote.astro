---
/**
 * A labelled note box: "Technical Note:" above the note itself.
 *
 * The reference uses a blue box for a technical note and an amber one for a
 * limit, so the colour travels with the data.
 */
import type { MmoPart, MmoTone } from '../../../data/mmo-family-pages';

interface Props {
  part: Extract<MmoPart, { kind: 'note' }>;
  tone?: MmoTone;
}

const { part, tone = 'plain' } = Astro.props;

const dark = tone === 'dark' || tone === 'navy';

const box = dark
  ? 'mmo-callout-dark'
  : part.variant === 'blue'
    ? 'mmo-callout-blue'
    : part.variant === 'amber'
      ? 'mmo-callout'
      : 'mmo-callout-soft';
---

<div class={box}>
  <p class="mmo-note-label">{part.label}</p>
  <p>{part.text}</p>
</div>
