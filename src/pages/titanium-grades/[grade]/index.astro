---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import GradePage from '../../../components/grade/GradePage.astro';
import { grades } from '../../../data/titanium-grades';
import { site } from '../../../data/site';

/**
 * One route per published grade.
 *
 * The grade record is the single source of truth, so the page title, the
 * description and the body can never disagree with the comparison table on
 * the hub page.
 */
export function getStaticPaths() {
  return grades.map((grade) => ({
    params: { grade: grade.slug },
    props: { grade },
  }));
}

const { grade } = Astro.props;

const origin = site.url.replace(/\/$/, '');
const canonicalUrl = new URL(Astro.url.pathname, origin).href;

/**
 * Every grade page answers the same three questions, so the FAQ is generated
 * from the grade record instead of being written nine times. The visible
 * accordion and the FAQPage node are rendered from this one array.
 */
const faqItems = [
  {
    question: `What is ${grade.grade} and when is it the right choice?`,
    answer: `${grade.grade} is ${grade.name}. ${grade.intro}`,
  },
  {
    question: `What are the chemical composition and mechanical properties of ${grade.grade}?`,
    answer:
      `The composition window for ${grade.grade} covers titanium as the balance plus the interstitials and, where applicable, the alloying additions. The mechanical window gives a tensile strength of ${grade.mechanical[0]?.value ?? 'see the table'}, a yield strength of ${grade.mechanical[1]?.value ?? 'see the table'} and an elongation of ${grade.mechanical[2]?.value ?? 'see the table'}. Both tables are reference windows; the standard revision named on the certificate governs the order.`,
  },
  {
    question: `Is ${grade.grade} available in the product forms I need?`,
    answer:
      'The product forms normally supplied in this grade are listed on this page. Availability in a specific size, condition or standard revision is confirmed during the quotation review, along with the certificate scope and the inspection plan.',
  },
];

const faqJsonLd = {
  '@type': 'FAQPage',
  '@id': `${canonicalUrl}#faq`,
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};

const jsonLd: Record<string, unknown>[] = [faqJsonLd];

// Title budget: the layout appends " | Titanium Parts" (16 chars) and the
// search-result limit is 70, so the grade title itself must stay under ~54.
const seoTitle = `${grade.grade} Titanium (${grade.unisteady}) Properties`;
const seoDescription = `${grade.grade} (${grade.unisteady}) titanium: chemical composition, mechanical properties, ASTM, ASME, AMS and EN standards, applications and the products we supply in this grade.`;
---

<BaseLayout title={seoTitle} description={seoDescription} jsonLd={jsonLd}>
  <PageHero
    eyebrow={`Titanium Grade · ${grade.family}`}
    title={`${grade.grade} Titanium — ${grade.unisteady}`}
    description={grade.intro}
  />
  <GradePage grade={grade} />

  <section id="faq" class="grade-faq-section">
    <div class="container">
      <h2 class="grade-faq-h2">{grade.grade} Questions</h2>
      <div class="grade-faq">
        {faqItems.map((item) => (
          <details class="grade-faq-item">
            <summary class="grade-faq-question">
              <span>{item.question}</span>
            </summary>
            <div class="grade-faq-answer">
              <p>{item.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .grade-faq-section { background: #fff; padding: 4.5rem 0; }
  .grade-faq-h2 {
    font-size: clamp(1.5rem, 2.6vw, 2.125rem); font-weight: 800; line-height: 1.2;
    color: var(--color-heading); margin-bottom: 2rem; letter-spacing: -0.015em; max-width: 820px;
  }
  .grade-faq { display: flex; flex-direction: column; gap: 0.75rem; max-width: 900px; }
  .grade-faq-item { background: #fff; border: 1px solid var(--color-border); border-radius: var(--radius-lg); overflow: hidden; }
  .grade-faq-item[open] { border-color: var(--color-primary-200); box-shadow: 0 6px 20px -12px rgba(15, 23, 42, 0.25); }
  .grade-faq-question {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    padding: 1.125rem 1.5rem; cursor: pointer; font-size: 1rem; font-weight: 600;
    color: var(--color-heading); list-style: none;
  }
  .grade-faq-question::-webkit-details-marker { display: none; }
  .grade-faq-answer { padding: 0 1.5rem 1.375rem; border-top: 1px solid var(--color-slate-100); }
  .grade-faq-answer p { margin: 0; padding-top: 0.9375rem; font-size: 0.9375rem; line-height: 1.75; color: var(--color-text-secondary); }
</style>
