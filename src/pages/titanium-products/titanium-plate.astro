---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';

const M = 'Titanium Plate & Sheet';

const hero = {
  eyebrow: 'ASTM B265 Titanium Flat Products',
  title: 'Titanium Plate & Sheet Manufacturer — Grade 2, Grade 5 & Custom Cut Sizes',
  desc: 'Source plate, sheet and cut blanks with grade, specification, condition, dimensions, surface, processing, inspection and documentation reviewed against your order requirements.',
  img: 'https://heletitanium.com/wp-content/uploads/2026/09/Titanium-Plates-Sheets-Manufacturer.webp',
  tags: ['Grades 2 · 5 · 7 · 23', 'Plate · Sheet · Cut Blanks', 'Order-Specific MTC & Inspection']
};

const orderBasis = [
  { title: 'Material', body: 'Grade, UNS, specification and revision, condition and supplementary requirements.' },
  { title: 'Geometry', body: 'Thickness, width, length, quantity, flatness, tolerance and machining allowance.' },
  { title: 'Processing', body: 'Full-size material or blanks, cut route, edge condition, surface and downstream fabrication.' },
  { title: 'Evidence', body: 'MTC, traceability, inspection, testing, marking, packing and release documents.' }
];

const grades = [
  {
    img: 'https://heletitanium.com/wp-content/uploads/2026/09/Grade-2-Titanium-Sheet.webp',
    alt: 'Grade 2 Titanium plate and sheet',
    title: 'Grade 2 Titanium',
    spec: 'ASTM B265 / B265M when specified · UNS R50400',
    body: 'Commercially pure titanium for chemical processing, marine and general fabrication where formability and corrosion resistance drive the grade choice.'
  },
  {
    img: 'https://heletitanium.com/wp-content/uploads/2026/09/Grade-5-Ti-6Al-4V-Plate-Sheet.webp',
    alt: 'Grade 5 / Ti-6Al-4V plate and sheet',
    title: 'Grade 5 / Ti-6Al-4V',
    spec: 'ASTM B265 or AMS 4911 as ordered · UNS R56400',
    body: 'High-strength alloy for aerospace, high-performance engineering and structural components where mechanical performance is required.'
  },
  {
    img: 'https://heletitanium.com/wp-content/uploads/2026/09/Marine-Grade-Sheet.webp',
    alt: 'Grade 7 Titanium plate and sheet',
    title: 'Grade 7 Titanium',
    spec: 'ASTM B265 / B265M when specified · UNS R52400',
    body: 'Pd-enhanced grade for reducing acid, chloride-rich and other aggressive chemical media beyond the Grade 2 capability window.'
  },
  {
    img: 'https://heletitanium.com/wp-content/uploads/2026/09/Grade-23-ELI-Medical-Sheet.webp',
    alt: 'Grade 23 / Ti-6Al-4V ELI plate and sheet',
    title: 'Grade 23 / Ti-6Al-4V ELI',
    spec: 'ASTM B265 or ASTM F136 only when ordered · UNS R56407',
    body: 'Extra-low-interstitial Grade 5 chemistry for medical and high-performance applications; specification and qualification scope are stated in the quotation.'
  }
];

const forms = [
  {
    title: 'Sheet',
    spec: 'For forming, fabricated panels and thinner flat-product requirements. State thickness and flatness explicitly.',
    href: '/titanium-products/titanium-foil-2/'
  },
  {
    title: 'Plate',
    spec: 'For heavier sections, machined parts and fabricated equipment. Define condition, allowance and inspection.',
    href: '/titanium-products/titanium-plate/'
  },
  {
    title: 'Cut Blanks',
    spec: 'Add blank geometry, cut tolerance, edge condition, datum and machining allowance.',
    href: '/manufacturing-capabilities/'
  },
  {
    title: 'Titanium Foil',
    spec: 'For ultra-thin requirements, use the dedicated foil page and confirm thickness, condition and handling.',
    href: '/titanium-products/titanium-foil-2/'
  }
];

const cuttingPrepList = [
  'Cut-to-size dimensions',
  'Edge and corner requirements',
  'Flatness and machining allowance',
  'Surface and protective handling'
];

const cuttingPrepImg = 'https://heletitanium.com/wp-content/uploads/2026/09/Precision-Processing-Cutting.webp';

const processSteps = [
  {
    img: 'https://heletitanium.com/wp-content/uploads/2026/09/Titanium-Slab-Preparation-scaled.webp',
    alt: 'Requirement Review for titanium flat products',
    title: 'Requirement Review',
    body: 'Grade, specification revision, condition, dimensions, quantity and document scope are aligned before supply.'
  },
  {
    img: 'https://heletitanium.com/wp-content/uploads/2026/09/Rolling-Precision.webp',
    alt: 'Material and Route Confirmation for titanium flat products',
    title: 'Material and Route Confirmation',
    body: 'The source material, preparation and processing route are confirmed against the accepted quotation.'
  },
  {
    img: 'https://heletitanium.com/wp-content/uploads/2026/09/Thermal-Surface-Integrity.webp',
    alt: 'Cutting and Surface Control for titanium flat products',
    title: 'Cutting and Surface Control',
    body: 'Cut method, allowance, edge condition and surface requirements are controlled to the agreed scope.'
  },
  {
    img: 'https://heletitanium.com/wp-content/uploads/2026/09/Inspection-Documentation.webp',
    alt: 'Inspection and Records for titanium flat products',
    title: 'Inspection and Records',
    body: 'Order-specific dimensional, surface, material or third-party checks are completed as agreed.'
  },
  {
    img: 'https://heletitanium.com/wp-content/uploads/2026/09/Final-Dimension-Packaging.webp',
    alt: 'Marking, Packing and Release for titanium flat products',
    title: 'Marking, Packing and Release',
    body: 'Identification, document set, protective packing and delivery basis are checked before release.'
  }
];

const mfgVideo = {
  poster: 'https://heletitanium.com/wp-content/uploads/2026/09/Titanium-Plates-Sheets-Manufacturer.webp',
  src: 'https://heletitanium.com/wp-content/uploads/2026/09/Titanium-Products-Manufacturer-Hele-Titanium.mp4'
};

const applications = [
  {
    img: 'https://heletitanium.com/wp-content/uploads/2026/09/Chemical-Processing01.webp',
    alt: 'Chemical Processing titanium plate and sheet application',
    title: 'Chemical Processing',
    spec: 'Define media, concentration, contaminants, temperature, pressure and fabrication duty before selecting Grade 2, 7 or another material.',
    href: '/industries/chemical-processing/'
  },
  {
    img: 'https://heletitanium.com/wp-content/uploads/2026/09/Marine-Offshore02.webp',
    alt: 'Marine & Offshore titanium plate and sheet application',
    title: 'Marine & Offshore',
    spec: 'Review seawater exposure, crevice conditions, mechanical loading, joining and maintenance access.',
    href: '/industries/marine-offshore/'
  },
  {
    img: 'https://heletitanium.com/wp-content/uploads/2026/09/Aerospace-High-Performance-Engineering04.webp',
    alt: 'Aerospace & High-Performance titanium plate and sheet application',
    title: 'Aerospace & High-Performance',
    spec: 'Confirm the approved material specification, condition, source and traceability requirements; general Grade 5 supply is not automatic aerospace approval.',
    href: '/industries/aerospace/'
  },
  {
    img: 'https://heletitanium.com/wp-content/uploads/2026/09/Medical-Precision-Engineering03.webp',
    alt: 'Medical & Precision titanium plate and sheet application',
    title: 'Medical & Precision',
    spec: 'Separate raw-material specification from finished-device qualification and regulatory responsibilities.',
    href: '/industries/medical/'
  }
];

const evidence = [
  { title: 'Material identity', body: 'Grade, heat or lot reference, product form and certificate link.', icon: 'tag' },
  { title: 'Dimensional evidence', body: 'Characteristics, method, sampling, tolerance and report format.', icon: 'ruler' },
  { title: 'Additional testing', body: 'Only tests and acceptance criteria stated in the agreed scope.', icon: 'flask' },
  { title: 'Document release', body: 'Required index, language, approval route and delivery timing.', icon: 'file-text' }
];

const controls = [
  { title: 'Material Identity', body: 'Grade, form, specification revision, condition and heat or lot basis.', icon: 'shield' },
  { title: 'Dimensions & Processing', body: 'Size, tolerance, surface, allowance, cut route and responsibility.', icon: 'settings' },
  { title: 'Evidence & Acceptance', body: 'Certificates, inspection, tests, hold points and acceptance criteria.', icon: 'badge-check' },
  { title: 'Commercial & Delivery', body: 'Quantity basis, exclusions, packing, Incoterm and schedule assumptions.', icon: 'truck' }
];

const faq = [
  { q: 'What information is needed for a titanium plate or sheet quotation?', a: 'Provide the grade, governing specification and revision, condition, thickness, width, length, quantity, surface requirement, cutting or processing scope, inspection documents, packing and destination. Add the drawing where cut blanks or tight tolerances are involved.' },
  { q: 'What is the difference between titanium sheet, plate and foil?', a: 'The terms describe flat products of different thickness ranges. The boundary can vary by specification and market practice. For purchasing, state the exact thickness, dimensions, grade, condition and governing specification rather than relying on the name alone.' },
  { q: 'Which grades can be reviewed for titanium plate and sheet?', a: 'Common enquiries include Grades 2, 5, 7 and 23. Other grades may be reviewed. Availability, dimensions, condition and the applicable standard must be confirmed for the specific order.' },
  { q: 'Can plate or sheet be supplied as cut blanks?', a: 'Cut-to-size blanks can be reviewed against the grade, thickness, geometry, tolerance, edge condition, machining allowance and quantity. The accepted process and final scope are stated in the quotation.' },
  { q: 'Are MTC, traceability and additional inspection included automatically?', a: 'No. Required certificates, traceability level, dimensional records, testing and third-party inspection should be listed before quotation. The confirmed document and inspection package becomes part of the order basis.' },
  { q: 'Are stock, MOQ and lead time fixed?', a: 'No. They depend on grade, standard, condition, dimensions, quantity, processing, inspection and current material availability. Treat them as quotation-specific values.' }
];

const rfqOptions = ['Titanium Plate', 'Titanium Sheet', 'Cut-to-Size Blank', 'Grade / Specification Review', 'Drawing / Specification (Optional)'];
---
<BaseLayout title={M + ' | Titanium Plate & Sheet Manufacturer — Grade 2, Grade 5 & Custom Cut Sizes'} description={hero.desc}>
  <!-- HERO -->
  <section id="plate-hero" class="tp-hero">
    <img src={hero.img} alt={hero.title} class="tp-hero-img" fetchpriority="high" decoding="async" loading="eager" />
    <div class="tp-hero-overlay"></div>
    <div class="tp-hero-inner">
      <p class="tp-hero-eyebrow">{hero.eyebrow}</p>
      <h1>{hero.title}</h1>
      <p class="tp-hero-lede">{hero.desc}</p>
      <div class="tp-hero-tags">
        {hero.tags.map((t) => <span class="tp-hero-tag">{t}</span>)}
      </div>
      <div class="tp-hero-cta">
        <a href="#tp-rfq" class="tp-btn-primary">Send Titanium Plate & Sheet Inquiry</a>
        <a href="/titanium-products/" class="tp-btn-secondary">All Products</a>
      </div>
    </div>
  </section>

  <!-- 1. FREEZE THE ORDER BASIS -->
  <section class="tp-section tp-blue-bg">
    <div class="tp-inner tp-orderbasis-v2">
      <div class="tp-orderbasis-head">
        <p class="tp-eyebrow">Buying Essentials</p>
        <h2 class="tp-h2">Freeze the Order Basis Before Comparing Price</h2>
      </div>
      <div class="tp-grid-2">
        {orderBasis.map((c) => (
          <div class="tp-ob-card">
            <h3>{c.title}</h3>
            <p>{c.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 2. GRADES -->
  <section class="tp-section">
    <div class="tp-inner">
      <p class="tp-eyebrow">Grade Reference</p>
      <h2 class="tp-h2">{M} Grades</h2>
      <p class="tp-lede">{M} grades reviewed against ASTM / ASME / project specifications.</p>
      <div class="tp-grid-4">
        {grades.map((g) => (
          <article class="tp-card tp-form-card">
            <div class="tp-form-img"><img src={g.img} alt={g.alt} loading="lazy" /></div>
            <div class="tp-form-body">
              <h3>{g.title}</h3>
              <p class="tp-form-spec"><strong>Standard:</strong> {g.spec}</p>
              <p class="tp-form-text">{g.body}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. SPECIFY THE EXACT FORM -->
  <section class="tp-section tp-alt">
    <div class="tp-inner">
      <p class="tp-eyebrow">Product Form</p>
      <h2 class="tp-h2">Specify the Exact Form, Not Only “Titanium Plate”</h2>
      <p class="tp-lede">Product forms, dimensions and acceptance criteria relevant to the titanium plate & sheet order basis.</p>
      <div class="tp-grid-4">
        {forms.map((f) => (
          <article class="tp-form-pure">
            <h3>{f.title}</h3>
            <p>{f.spec}</p>
            <a href={f.href} class="tp-form-link">View {f.title} →</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. CUTTING AND PREPARATION -->
  <section class="tp-section">
    <div class="tp-inner tp-cutprep-grid">
      <div>
        <p class="tp-eyebrow">Processing Options</p>
        <h2 class="tp-h2">Cutting and Preparation Matched to the Next Process</h2>
        <p class="tp-lede">Cutting, surface preparation and machining-ready blanks can be reviewed according to grade, thickness, geometry, allowance, edge condition, tolerance and quantity.</p>
        <ul class="tp-cutprep-list">
          {cuttingPrepList.map((item) => (
            <li><Icon name="check" size={20} className="tp-icon-blue" /> {item}</li>
          ))}
        </ul>
        <p class="tp-cutprep-note"><strong>Before Requesting a Quote:</strong> identify critical dimensions and the downstream machining or fabrication route. The cutting method and achievable tolerance remain order-specific.</p>
      </div>
      <div class="tp-cutprep-img">
        <img src={cuttingPrepImg} alt="Titanium plate and sheet cutting and preparation" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- 5. COORDINATE THE ORDER (Process) -->
  <section class="tp-section tp-dark">
    <div class="tp-inner">
      <div class="tp-process-head">
        <p class="tp-eyebrow tp-eyebrow-light">Process Review</p>
        <h2 class="tp-h2 tp-h-light">Coordinate the Order from Specification to Release</h2>
        <p class="tp-lede tp-lede-light">Plate and sheet are hot and cold rolled in our own facility. Cutting, surface preparation, inspection scope and documentation are confirmed by quotation against the approved order basis.</p>
      </div>
      <div class="tp-grid-5">
        {processSteps.map((c, i) => (
          <article class="tp-process-card-v2">
            <div class="tp-process-img"><img src={c.img} alt={c.alt} loading="lazy" /></div>
            <div class="tp-process-body">
              <span class="tp-process-num">{i + 1}</span>
              <h3>{c.title}</h3>
              <p>{c.body}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. MANUFACTURING ENVIRONMENT -->
  <section class="tp-section">
    <div class="tp-inner tp-mfg-grid">
      <div>
        <p class="tp-eyebrow">Inside Titanium Parts</p>
        <h2 class="tp-h2">{M} Manufacturing Environment</h2>
        <p class="tp-lede">Plate and sheet rolling, cutting, surface preparation and inspection are carried out in our own facility. The inspection scope and documentation for a specific order are agreed in the quotation.</p>
      </div>
      <div class="tp-mfg-video">
        <video controls preload="metadata" playsinline poster={mfgVideo.poster}>
          <source src={mfgVideo.src} type="video/mp4" />
          Your browser does not support HTML5 video.
        </video>
      </div>
    </div>
  </section>

  <!-- 7. APPLICATIONS -->
  <section class="tp-section tp-alt">
    <div class="tp-inner">
      <p class="tp-eyebrow">Industry Context</p>
      <h2 class="tp-h2">Match Material Decisions to the Actual Service</h2>
      <p class="tp-lede">Grade, condition and documentation choices follow from the operating environment, not from the section name. Each context below sets the typical qualification conversation before the first quotation.</p>
      <div class="tp-grid-4">
        {applications.map((c) => (
          <article class="tp-card tp-form-card tp-app-card">
            <div class="tp-form-img"><img src={c.img} alt={c.alt} loading="lazy" /></div>
            <div class="tp-form-body">
              <h3>{c.title}</h3>
              <p class="tp-form-spec">{c.spec}</p>
              <a href={c.href} class="tp-app-link">Review the industry context →</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 8. EVIDENCE -->
  <section class="tp-section">
    <div class="tp-inner tp-evidence-grid">
      <div>
        <p class="tp-eyebrow">Supply Scope & Qualification</p>
        <h2 class="tp-h2">Specify the Evidence Needed for Acceptance</h2>
        <p class="tp-lede">A certificate name alone does not define the complete acceptance package. State the traceability level, inspection characteristics, test reports, marking, third-party involvement and release documents required by the order.</p>
      </div>
      <div class="tp-evidence-cards">
        {evidence.map((c) => (
          <div class="tp-evidence-card">
            <Icon name={c.icon} size={22} className="tp-icon-blue" />
            <h3>{c.title}</h3>
            <p>{c.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 9. CONTROLS -->
  <section class="tp-section tp-dark">
    <div class="tp-inner">
      <p class="tp-eyebrow tp-eyebrow-light">Before You Order</p>
      <h2 class="tp-h2 tp-h-light">Confirm Four Controls Before You Buy</h2>
      <p class="tp-lede tp-lede-light">Four checks that catch most order-basis errors before they become commercial or quality problems.</p>
      <div class="tp-grid-4">
        {controls.map((c) => (
          <article class="tp-control-card">
            <Icon name={c.icon} size={28} className="tp-icon-blue" />
            <h3>{c.title}</h3>
            <p>{c.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 10. FAQ -->
  <section class="tp-section tp-alt">
    <div class="tp-inner">
      <p class="tp-eyebrow">Questions</p>
      <h2 class="tp-h2">{M} FAQ</h2>
      <p class="tp-lede">Common questions before sending the inquiry.</p>
      <div class="tp-faq-grid">
        {faq.map((f) => (
          <details class="tp-faq">
            <summary>
              <span>{f.q}</span>
              <span class="tp-faq-icon">+</span>
            </summary>
            <div class="tp-faq-a"><p>{f.a}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 11. SEND INQUIRY / RFQ -->
  <section id="tp-rfq" class="tp-section tp-dark tp-rfq-sec">
    <div class="tp-inner tp-rfq-grid">
      <aside class="tp-rfq-side">
        <h2 class="tp-h2 tp-h-light">Send the Order Basis for Supply Review</h2>
        <p class="tp-lede tp-lede-light">Share the available grade, specification, dimensions, quantity, processing and evidence requirements. A drawing is helpful for cut blanks and controlled tolerances, but it is optional for the first enquiry.</p>
        <ul class="tp-rfq-checks">
          <li><Icon name="check" size={18} className="tp-icon-light" /> Grade and specification review</li>
          <li><Icon name="check" size={18} className="tp-icon-light" /> Plate, sheet or cut-blank scope</li>
          <li><Icon name="check" size={18} className="tp-icon-light" /> Processing and inspection requirements</li>
          <li><Icon name="check" size={18} className="tp-icon-light" /> Quotation-specific availability and delivery basis</li>
        </ul>
        <p class="tp-rfq-prefer">Prefer email? <a href="mailto:sales@titanium-parts.com">sales@titanium-parts.com</a></p>
        <p class="tp-rfq-hq">HQ: Titanium Valley, Baoji City, Shaanxi Province, China</p>
      </aside>
      <form class="tp-rfq-form" data-variant="titanium-plate">
        <h3 class="tp-rfq-form-title">{M} Inquiry</h3>
        <div class="tp-rfq-row">
          <div class="tp-rfq-field">
            <label>Full Name <span>*</span></label>
            <input type="text" name="fullName" required />
          </div>
          <div class="tp-rfq-field">
            <label>Business Email <span>*</span></label>
            <input type="email" name="email" required />
          </div>
        </div>
        <div class="tp-rfq-field">
          <label>Product of Interest <span>*</span></label>
          <select name="interest" required>
            <option value="">Select an option...</option>
            {rfqOptions.map((opt) => <option value={opt}>{opt}</option>)}
          </select>
        </div>
        <div class="tp-rfq-field">
          <label>Grade / Specification Review</label>
          <input type="text" name="grade" placeholder="e.g. Grade 2, ASTM B265, 5mm × 1000 × 2000mm" />
        </div>
        <div class="tp-rfq-field">
          <label>Drawing / Specification (Optional)</label>
          <div class="tp-rfq-upload">
            <Icon name="upload" size={32} className="tp-rfq-upload-icon" />
            <span class="tp-rfq-upload-text">Supported formats: PDF, JPG, PNG, STEP, IGES, STL, DWG (Max 20MB)</span>
            <input type="file" name="attachment" multiple accept=".pdf,.jpg,.jpeg,.png,.step,.iges,.stl,.dwg" />
          </div>
          <p class="tp-rfq-upload-hint">PDF, image and common CAD formats are accepted.</p>
        </div>
        <div class="tp-rfq-field">
          <label>Message / Specifications <span>*</span></label>
          <textarea name="message" rows="5" required></textarea>
        </div>
        <button type="submit" class="tp-btn-primary tp-btn-block">Send Plate & Sheet Inquiry</button>
        <p class="tp-rfq-privacy">Your information will only be used to respond to your inquiry and support your project review. We respect your privacy.</p>
      </form>
    </div>
  </section>
</BaseLayout>

<style>
/* ===== HERO ===== */
.tp-hero { position: relative; min-height: 680px; padding: 5rem 0 4rem; color: #fff; overflow: hidden; display: flex; align-items: center; justify-content: flex-start; }
.tp-hero-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 1; }
.tp-hero-overlay { position: absolute; inset: 0; background: linear-gradient(90deg, #020617 0%, rgba(2,6,23,0.9) 50%, rgba(23,37,84,0.45) 100%); z-index: 2; }
.tp-hero-inner { position: relative; z-index: 3; max-width: 1024px; margin: 0 auto; padding: 0 1.5rem; width: 100%; }
.tp-hero-eyebrow { display: inline-block; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: #93c5fd; margin: 0 0 1.25rem; }
.tp-hero h1 { font-size: clamp(2.25rem, 5vw, 3.75rem); font-weight: 800; color: #fff; line-height: 1.1; letter-spacing: -0.025em; margin: 0 0 1.25rem; }
.tp-hero-lede { font-size: clamp(1rem, 1.6vw, 1.25rem); color: #cbd5e1; line-height: 1.65; max-width: 900px; margin: 0 0 1.5rem; }
.tp-hero-tags { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 2rem; }
.tp-hero-tag { display: inline-block; padding: 0.5rem 1rem; border: 1px solid rgba(255,255,255,0.25); background: rgba(255,255,255,0.08); color: #fff; font-size: 0.875rem; font-weight: 600; border-radius: 999px; }
.tp-hero-cta { display: flex; flex-wrap: wrap; gap: 0.85rem; margin-top: 1rem; }
.tp-btn-primary { display: inline-flex; align-items: center; justify-content: center; background: #2563eb; color: #fff; padding: 0.875rem 1.75rem; border-radius: 8px; font-weight: 700; text-decoration: none; border: none; cursor: pointer; font-size: 0.9375rem; transition: background-color 0.2s; min-height: 48px; }
.tp-btn-primary:hover { background: #1d4ed8; }
.tp-btn-secondary { display: inline-flex; align-items: center; justify-content: center; background: transparent; color: #fff; padding: 0.875rem 1.75rem; border: 1px solid rgba(255,255,255,0.6); border-radius: 8px; font-weight: 700; text-decoration: none; transition: all 0.2s; min-height: 48px; }
.tp-btn-secondary:hover { background: rgba(255,255,255,0.1); border-color: #fff; }
.tp-btn-block { display: flex; width: 100%; justify-content: center; padding: 1rem 1.75rem; font-size: 1.0625rem; }

/* ===== SECTIONS ===== */
.tp-section { padding: 5rem 0; background: #fff; }
.tp-section.tp-alt { background: #f8fafc; }
.tp-section.tp-blue-bg { background: #eff6ff; }
.tp-section.tp-dark { background: #020617; color: #fff; }
.tp-inner { max-width: 1280px; margin: 0 auto; padding: 0 1.5rem; }
