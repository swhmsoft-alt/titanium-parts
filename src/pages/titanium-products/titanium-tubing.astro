---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';

const M = 'Titanium Tube &amp; Pipe';

const hero = {
  eyebrow: 'ASTM B338 Tube · ASTM B861/B862 Pipe',
  title: 'Titanium Tube &amp; Pipe Manufacturer in China — Seamless &amp; Welded',
  desc: 'Source seamless or welded titanium tube and pipe with product form, grade, specification, dimensions, condition, testing and documentation reviewed against your purchase requirements.',
  img: 'https://heletitanium.com/wp-content/uploads/2026/09/Titanium-Tube-Pipe-Manufacturer-1.webp',
  tags: ['B338 Tube · B861 Seamless Pipe · B862 Welded Pipe', 'OD/Wall · NPS/Schedule · Drawing-Based', 'Order-Specific MTC & Testing']
};

const orderBasis = [
  { title: 'Tube or pipe', body: 'B338 tube, B861 seamless pipe, B862 welded pipe or drawing-based tubing.' },
  { title: 'Material and dimensions', body: 'Grade, UNS, revision, condition, OD and wall or NPS and schedule, length and quantity.' },
  { title: 'Fabrication and service', body: 'Media, temperature, pressure, joining, bending, ends, cleanliness and design code.' },
  { title: 'Evidence and release', body: 'MTC, traceability, dimensional records, specified tests, marking, packing and documents.' }
];

// Tube & Pipe Range - 8 product cards (matching original)
const forms = [
  {
    img: 'https://heletitanium.com/wp-content/uploads/2026/09/Heat-Exchanger-Tube.webp',
    alt: 'ASTM B338 Titanium Tube',
    title: 'ASTM B338 Titanium Tube',
    spec: 'Specify: OD × wall thickness × length',
    body: 'Seamless or welded tube for condenser and heat-exchanger service when B338 is specified.'
  },
  {
    img: 'https://heletitanium.com/wp-content/uploads/2026/09/Titanium-Seamless-Pipe.webp',
    alt: 'ASTM B861 Seamless Pipe',
    title: 'ASTM B861 Seamless Pipe',
    spec: 'Specify: NPS × schedule or exact OD × wall',
    body: 'Seamless pipe for corrosion-resisting and elevated-temperature service under the ordered specification.'
  },
  {
    img: 'https://heletitanium.com/wp-content/uploads/2026/09/Titanium-Welded-Pipe.webp',
    alt: 'ASTM B862 Welded Pipe',
    title: 'ASTM B862 Welded Pipe',
    spec: 'Specify: NPS × schedule or exact OD × wall',
    body: 'Welded pipe with material, weld, condition, dimensions and testing controlled by the purchase order.'
  },
  {
    img: 'https://heletitanium.com/wp-content/uploads/2026/09/Heat-Exchanger-Tube.webp',
    alt: 'Heat Exchanger Tube',
    title: 'Heat Exchanger Tube',
    spec: 'Specify: Grade · OD · wall · length · tests',
    body: 'Straight or project-specific tube for condensers and heat exchangers with service and cleanliness requirements defined.'
  },
  {
    img: 'https://heletitanium.com/wp-content/uploads/2026/09/Aerospace-Thin-Wall-Tube.webp',
    alt: 'Thin-Wall Tube',
    title: 'Thin-Wall Tube',
    spec: 'Specify: Grade · OD · wall · tolerance',
    body: 'Thin-wall tubing reviewed by alloy, formability, fabrication route and dimensional control.'
  },
  {
    img: 'https://heletitanium.com/wp-content/uploads/2026/09/Titanium-Capillary-Tube.webp',
    alt: 'Capillary Tube',
    title: 'Capillary Tube',
    spec: 'Specify: OD · ID or wall · length · tolerance',
    body: 'Small-diameter tubing reviewed for instrumentation or precision fluid-handling requirements.'
  },
  {
    img: 'https://heletitanium.com/wp-content/uploads/2026/09/Square-Rectangular-Tube.webp',
    alt: 'Shaped &amp; Custom Tube',
    title: 'Shaped &amp; Custom Tube',
    spec: 'Specify: Drawing · section · wall · grade',
    body: 'Square, rectangular and other drawing-based profiles supplied to an agreed drawing or applicable specification.'
  },
  {
    img: 'https://heletitanium.com/wp-content/uploads/2026/09/Custom-Fabricated-U-Bend.webp',
    alt: 'Fabricated Tube',
    title: 'Fabricated Tube',
    spec: 'Specify: Drawing · geometry · tolerance · quantity',
    body: 'Cutting, bending, U-bend, coiling and end preparation reviewed as an explicit processing scope.'
  }
];

// Specification Mapping table
const specMapping = [
  { route: 'Condenser / heat-exchanger tube', dimensions: 'OD × wall × length', spec: 'ASTM B338 / ASME SB-338', scope: 'Seamless or welded tube; confirm grade, revision, condition and tests.' },
  { route: 'Seamless pipe', dimensions: 'NPS × schedule or exact dimensions', spec: 'ASTM B861 / ASME SB-861', scope: 'Seamless pipe; define service, design code, ends and test package.' },
  { route: 'Welded pipe', dimensions: 'NPS × schedule or exact dimensions', spec: 'ASTM B862 / ASME SB-862', scope: 'Welded pipe; define weld route, condition, NDT and acceptance.' },
  { route: 'Shaped / fabricated tube', dimensions: 'Drawing and controlled dimensions', spec: 'Customer drawing or verified standard', scope: 'Do not apply B861 automatically to square or rectangular tube.' }
];

// Engineering Inputs (4 cards)
const engineeringInputs = [
  { title: 'Service conditions', body: 'Media, concentration, contaminants, temperature, pressure, velocity and cycling.' },
  { title: 'Geometry', body: 'OD, wall, ID, NPS, schedule, tolerance, straightness, length and ends.' },
  { title: 'Fabrication', body: 'Seamless or welded route, bending, joining, heat treatment, cleaning and inspection.' },
  { title: 'Design responsibility', body: 'Design code, allowable stress, joint factor, allowances and approval authority.' }
];

// 5 Process steps (specific to tubing)
const processSteps = [
  { img: 'https://heletitanium.com/wp-content/uploads/2026/09/Requirement-Review-Titanium-Supply.webp', alt: 'Requirement Review for titanium tube and pipe', title: 'Requirement Review', body: 'Form, standard, grade, dimensions, service and documents.' },
  { img: 'https://heletitanium.com/wp-content/uploads/2026/09/Seamless-Welded-Route.webp', alt: 'Seamless or Welded Route', title: 'Seamless or Welded Route', body: 'Seamless, welded, source condition and processing boundary.' },
  { img: 'https://heletitanium.com/wp-content/uploads/2026/09/Sizing-Fabrication-Tube.webp', alt: 'Sizing & Fabrication', title: 'Sizing & Fabrication', body: 'Cutting, ends, bending or drawing-based work as agreed.' },
  { img: 'https://heletitanium.com/wp-content/uploads/2026/09/Inspection-Tests-Tube.webp', alt: 'Inspection & Tests', title: 'Inspection & Tests', body: 'Order-specific dimensions, visual checks, tests and reports.' },
  { img: 'https://heletitanium.com/wp-content/uploads/2026/09/Marking-Release-Tube.webp', alt: 'Marking & Release', title: 'Marking & Release', body: 'Traceability, protection, packing, documents and delivery basis.' }
];

const mfgVideo = {
  poster: 'https://heletitanium.com/wp-content/uploads/2026/09/Titanium-Products-Manufacturer-Hele-Titanium.webp',
  src: 'https://heletitanium.com/wp-content/uploads/2026/09/Titanium-Products-Manufacturer-Hele-Titanium.mp4'
};

// 4 application contexts (specific to tubing)
const applications = [
  {
    img: 'https://heletitanium.com/wp-content/uploads/2026/09/Heat-Exchangers-Condensers.png',
    alt: 'Heat Exchangers &amp; Condensers titanium tube and pipe application',
    title: 'Heat Exchangers &amp; Condensers',
    spec: 'Define thermal duty, media, temperature, pressure, grade, dimensions, cleanliness, ends and applicable B338 inspection requirements.',
    href: '/industries/chemical-processing/'
  },
  {
    img: 'https://heletitanium.com/wp-content/uploads/2026/09/Chemical-Petrochemical-Processing.webp',
    alt: 'Chemical Processing &amp; Piping titanium tube and pipe application',
    title: 'Chemical Processing &amp; Piping',
    spec: 'Define chemistry, concentration, contaminants, temperature, pressure, design code, NPS or dimensions, fabrication and inspection.',
    href: '/industries/chemical-processing/'
  },
  {
    img: 'https://heletitanium.com/wp-content/uploads/2026/09/Marine-Offshore02.webp',
    alt: 'Marine &amp; Seawater Systems titanium tube and pipe application',
    title: 'Marine &amp; Seawater Systems',
    spec: 'Review temperature, velocity, crevices, galvanic contacts, pressure boundary, joining and maintenance access.',
    href: '/industries/marine-offshore/'
  },
  {
    img: 'https://heletitanium.com/wp-content/uploads/2026/09/Have-a-Non-Standard-Requirement.webp',
    alt: 'Industrial Fabrication &amp; OEM titanium tube and pipe application',
    title: 'Industrial Fabrication &amp; OEM',
    spec: 'Use the approved drawing to control form, grade, dimensions, bending, welding, cleanliness, inspection and responsibility.',
    href: '/manufacturing-capabilities/'
  }
];

// 4 Evidence items (specific to tubing)
const evidence = [
  { title: 'Material identity', body: 'Grade, heat or lot, form, condition and certificate link.' },
  { title: 'Dimensional records', body: 'OD, wall, length, straightness, ends and agreed tolerances.' },
  { title: 'Testing evidence', body: 'Method, acceptance criteria, sampling, witness point and report.' },
  { title: 'Release package', body: 'Document index, marking, packing, shipping records and approval route.' }
];

// 4 Controls (specific to tubing)
const controls = [
  { title: 'Product &amp; Material Identity', body: 'Tube or pipe, seamless or welded, grade, standard revision and condition.' },
  { title: 'Dimensions &amp; Fabrication', body: 'OD/wall or NPS/schedule, length, tolerance, ends, joining and processing.' },
  { title: 'Testing &amp; Acceptance', body: 'Certificates, inspection, specified tests, witness points and release criteria.' },
  { title: 'Commercial &amp; Delivery', body: 'Quantity basis, exclusions, packing, Incoterm and schedule assumptions.' }
];

// 6 FAQ items
const faq = [
  { q: 'What information is needed for a titanium tube or pipe quotation?', a: 'Provide the product form, grade, specification and revision, condition, dimensions, quantity, service, testing and document requirements. A drawing is optional for the first enquiry and recommended for shaped or fabricated products.' },
  { q: 'What is the difference between titanium tube and titanium pipe?', a: 'The two terms describe different dimensional and specification scopes. Tube is typically sized by outside diameter and wall, pipe by NPS and schedule. Confirm which one is required by the governing specification and service code.' },
  { q: 'What is the difference between ASTM B338, B861 and B862?', a: 'B338 covers seamless and welded tubes intended for condenser and heat-exchanger service; ASTM B861 covers seamless titanium pipe; ASTM B862 covers welded titanium pipe. State the required revision and supplementary requirements in the order.' },
  { q: 'Can Titanium Parts supply both seamless and welded products?', a: 'Yes. Seamless tube and pipe are produced by hot extrusion and welded tube and pipe by TIG welding, both in our own factory. Sizes, grades, condition, testing scope and lead time are confirmed per order' },
  { q: 'How is the pressure rating of titanium tube or pipe determined?', a: 'It cannot be determined from the material name alone. The responsible designer must apply the governing design code using dimensions, material properties at design temperature, joint factors, allowances, service conditions and system details.' },
  { q: 'Are hydrostatic, pneumatic, eddy-current, ultrasonic or third-party tests included automatically?', a: 'No. Applicable tests, sampling, acceptance criteria, witness points and reports depend on the product specification and purchase order. They must be agreed before quotation and order release.' }
];

const rfqOptions = [
  'ASTM B338 Titanium Tube',
  'ASTM B861 Seamless Pipe',
  'ASTM B862 Welded Pipe',
  'Heat Exchanger Tube',
  'Thin-Wall / Capillary Tube',
  'Shaped / Fabricated Tube',
  'Grade / Specification Review'
];
---
<BaseLayout title={M + ' Manufacturer in China — Seamless & Welded'} description={hero.desc}>
  <!-- HERO -->
  <section class="tp-hero">
    <img src={hero.img} alt={hero.title} class="tp-hero-img" fetchpriority="high" decoding="async" loading="eager" />
    <div class="tp-hero-overlay"></div>
    <div class="tp-hero-inner">
      <p class="tp-hero-eyebrow">{hero.eyebrow}</p>
      <h1>{hero.title}</h1>
      <p class="tp-hero-lede">{hero.desc}</p>
      <div class="tp-hero-tags">
        {hero.tags.map((t) => <span class="tp-hero-tag" set:html={t}></span>)}
      </div>
      <div class="tp-hero-cta">
        <a href="#forms-section" class="tp-btn-primary">Choose Tube or Pipe</a>
        <a href="#tp-rfq" class="tp-btn-secondary">Request a Quote</a>
      </div>
    </div>
  </section>

  <!-- 1. ORDER BASIS -->
  <section class="tp-section tp-blue-bg">
    <div class="tp-inner tp-orderbasis-v2">
      <div class="tp-orderbasis-head">
        <p class="tp-eyebrow">Buying Essentials</p>
        <h2 class="tp-h2">Start with Product Form, Standard and Design Basis</h2>
      </div>
      <div class="tp-grid-2">
        {orderBasis.map((c) => (
          <div class="tp-ob-card">
            <h3>{c.title}</h3>
            <p>{c.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 2. TUBE & PIPE RANGE -->
  <section id="forms-section" class="tp-section">
    <div class="tp-inner">
      <p class="tp-eyebrow">Tube &amp; Pipe Range</p>
      <h2 class="tp-h2">Separate the Product Routes Before Quotation</h2>
      <p class="tp-lede">B338 tube, B861 seamless pipe and B862 welded pipe are not interchangeable labels. Custom and fabricated products also require a defined drawing and responsibility boundary.</p>
      <div class="tp-grid-4">
        {forms.map((c) => (
          <article class="tp-card tp-form-card">
            <div class="tp-form-img"><img src={c.img} alt={c.alt} loading="lazy" /></div>
            <div class="tp-form-body">
              <h3>{c.title}</h3>
              <p class="tp-form-spec"><strong>Specify:</strong> {c.spec}</p>
              <p class="tp-form-text">{c.body}</p>
              <p class="tp-form-text" style="color:#64748b; font-size:0.8125rem; margin-top:0.5rem;"><em>Grade, dimensions, condition and availability: confirmed by quotation.</em></p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 2b. SPECIFICATION MAPPING TABLE -->
  <section class="tp-section tp-alt">
    <div class="tp-inner">
      <p class="tp-eyebrow">Specification Mapping</p>
      <h2 class="tp-h2">Match the Standard to the Ordered Product</h2>
      <div class="tp-spec-table-wrap">
        <table class="tp-spec-table">
          <thead>
            <tr>
              <th>Product route</th>
              <th>Typical order dimensions</th>
              <th>Specification when required</th>
              <th>Scope boundary</th>
            </tr>
          </thead>
          <tbody>
            {specMapping.map((row) => (
              <tr>
                <td><strong>{row.route}</strong></td>
                <td>{row.dimensions}</td>
                <td>{row.spec}</td>
                <td>{row.scope}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="tp-lede" style="margin-top:1.5rem;">Not every grade is included or available in every product form, size, condition or specification. Confirm the exact combination in the quotation.</p>
    </div>
  </section>

  <!-- 3. ENGINEERING INPUTS -->
  <section class="tp-section">
    <div class="tp-inner">
      <p class="tp-eyebrow">Engineering Inputs</p>
      <h2 class="tp-h2">Pressure and Corrosion Claims Need a Defined Basis</h2>
      <p class="tp-lede">A material grade or successful product test does not create a system pressure rating. The responsible designer must apply the governing code using actual dimensions, material properties at design temperature, joint factors, allowances, service conditions and system configuration.</p>
      <div class="tp-grid-4">
        {engineeringInputs.map((c) => (
          <article class="tp-card">
            <h3>{c.title}</h3>
            <p>{c.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. PROCESS REVIEW (Coordinate the Order) -->
  <section class="tp-section tp-dark">
    <div class="tp-inner">
      <div class="tp-process-head">
        <p class="tp-eyebrow tp-eyebrow-light">Process Review</p>
        <h2 class="tp-h2 tp-h-light">Coordinate the Order from Definition to Release</h2>
        <p class="tp-lede tp-lede-light">Seamless and welded tube and pipe are produced in our own factory. Sizing, fabrication, the inspection route and the document package are confirmed for each order.</p>
      </div>
      <div class="tp-grid-5">
        {processSteps.map((c, i) => (
          <article class="tp-process-card-v2">
            <div class="tp-process-img"><img src={c.img} alt={c.alt} loading="lazy" /></div>
            <div class="tp-process-body">
              <span class="tp-process-num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{c.title}</h3>
              <p>{c.body}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. MANUFACTURING ENVIRONMENT -->
  <section class="tp-section">
    <div class="tp-inner tp-mfg-grid">
      <div>
        <p class="tp-eyebrow">Inside Titanium Parts</p>
        <h2 class="tp-h2">{M} Manufacturing Environment</h2>
        <p class="tp-lede">Seamless extrusion, TIG welding, sizing and inspection are carried out in our own factory. The inspection scope and documentation for a specific order are agreed in the quotation.</p>
      </div>
      <div class="tp-mfg-video">
        <video controls preload="metadata" playsinline poster={mfgVideo.poster}>
          <source src={mfgVideo.src} type="video/mp4" />
          Your browser does not support HTML5 video.
        </video>
      </div>
    </div>
  </section>

  <!-- 6. APPLICATION CONTEXT -->
  <section class="tp-section tp-alt">
    <div class="tp-inner">
      <p class="tp-eyebrow">Application Context</p>
      <h2 class="tp-h2">Match the Product Route to the Service and System</h2>
      <p class="tp-lede">Industry labels are starting points. Final selection depends on service data, product specification, design code, fabrication and acceptance responsibilities.</p>
      <div class="tp-grid-4">
        {applications.map((c) => (
          <article class="tp-card tp-form-card tp-app-card">
            <div class="tp-form-img"><img src={c.img} alt={c.alt} loading="lazy" /></div>
            <div class="tp-form-body">
              <h3>{c.title}</h3>
              <p class="tp-form-spec">{c.spec}</p>
              <a href={c.href} class="tp-app-link">Review the application context →</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 7. EVIDENCE / SUPPLY SCOPE -->
  <section class="tp-section">
    <div class="tp-inner tp-evidence-grid">
      <div>
        <p class="tp-eyebrow">Supply Scope &amp; Qualification</p>
        <h2 class="tp-h2">Specify Tests and Records Before Quotation</h2>
        <p class="tp-lede">Hydrostatic, pneumatic, eddy-current, ultrasonic, penetrant or other testing must be tied to the applicable specification, product route, acceptance criteria, sampling and order scope. Do not assume every method is required or included.</p>
      </div>
      <div class="tp-evidence-cards">
        {evidence.map((c) => (
          <div class="tp-evidence-card">
            <Icon name="badge-check" size={22} className="tp-icon-blue" />
            <h3 set:html={c.title}></h3>
            <p>{c.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 8. CONTROLS -->
  <section class="tp-section tp-dark">
    <div class="tp-inner">
      <p class="tp-eyebrow tp-eyebrow-light">Before You Order</p>
      <h2 class="tp-h2 tp-h-light">Confirm Four Controls Before You Buy</h2>
      <p class="tp-lede tp-lede-light">Use this short check before comparing quotations. The complete guide covers standard selection, pressure-design boundaries, supplier evidence and commercial risk.</p>
      <p style="margin: 0 0 2rem;"><a href="/knowledge-center/" class="tp-btn-primary" style="font-size:0.9375rem;">Read the Complete Purchase Guide</a></p>
      <div class="tp-grid-4">
        {controls.map((c) => (
          <article class="tp-control-card">
            <Icon name="badge-check" size={28} className="tp-icon-blue" />
            <h3 set:html={c.title}></h3>
            <p>{c.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 9. FAQ -->
  <section class="tp-section tp-alt">
    <div class="tp-inner">
      <p class="tp-eyebrow">Frequently Asked Questions</p>
      <h2 class="tp-h2">{M} FAQ</h2>
      <p class="tp-lede">Common questions before sending the inquiry.</p>
      <div class="tp-faq-grid">
        {faq.map((f) => (
          <details class="tp-faq">
            <summary>
              <span>{f.q}</span>
              <span class="tp-faq-icon">+</span>
            </summary>
            <div class="tp-faq-a"><p>{f.a}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 10. RFQ -->
  <section id="tp-rfq" class="tp-section tp-dark tp-rfq-sec">
    <div class="tp-inner tp-rfq-grid">
      <aside class="tp-rfq-side">
        <p style="color:#93c5fd; font-size:0.75rem; font-weight:700; letter-spacing:0.18em; text-transform:uppercase; margin:0 0 0.75rem;">Titanium Tube &amp; Pipe Inquiry</p>
        <h2 class="tp-h2 tp-h-light">Send the Order Basis for Supply Review</h2>
        <p class="tp-lede tp-lede-light">Share the available product form, grade, specification, dimensions, quantity, service, testing and document requirements. A drawing is optional for the first enquiry and recommended for shaped or fabricated products.</p>
        <ul class="tp-rfq-checks">
          <li><Icon name="check" size={18} className="tp-icon-light" /> B338, B861 or B862 route review</li>
          <li><Icon name="check" size={18} className="tp-icon-light" /> Grade, dimensions and condition review</li>
          <li><Icon name="check" size={18} className="tp-icon-light" /> Testing and documentation checklist</li>
          <li><Icon name="check" size={18} className="tp-icon-light" /> Quotation-specific availability and delivery basis</li>
        </ul>
        <p class="tp-rfq-prefer">Prefer email? <a href="mailto:sales@titanium-parts.com">sales@titanium-parts.com</a></p>
        <p class="tp-rfq-hq">HQ: Titanium Valley, Baoji City, Shaanxi Province, China</p>
      </aside>
      <form class="tp-rfq-form" data-variant="titanium-tubing">
        <h3 class="tp-rfq-form-title">Titanium Tube &amp; Pipe Inquiry</h3>
        <div class="tp-rfq-row">
          <div class="tp-rfq-field">
            <label>Full Name <span>*</span></label>
            <input type="text" name="fullName" required />
          </div>
          <div class="tp-rfq-field">
            <label>Business Email <span>*</span></label>
            <input type="email" name="email" required />
          </div>
        </div>
        <div class="tp-rfq-field">
          <label>Product of Interest <span>*</span></label>
          <select name="interest" required>
            <option value="">Select an option...</option>
            {rfqOptions.map((opt) => <option value={opt}>{opt}</option>)}
          </select>
        </div>
        <div class="tp-rfq-field">
          <label>Grade / Specification Review</label>
          <input type="text" name="grade" placeholder="e.g. Grade 2, ASTM B338, 25.4mm OD × 0.7mm wall × 6000mm" />
        </div>
        <div class="tp-rfq-field">
          <label>Drawing / Specification (Optional)</label>
          <div class="tp-rfq-upload">
            <Icon name="upload" size={32} className="tp-rfq-upload-icon" />
            <span class="tp-rfq-upload-text">Supported formats: PDF, JPG, PNG, STEP, IGES, STL, DWG (Max 20MB)</span>
            <input type="file" name="attachment" multiple accept=".pdf,.jpg,.jpeg,.png,.step,.iges,.stl,.dwg" />
          </div>
          <p class="tp-rfq-upload-hint">PDF, image and common CAD formats are accepted.</p>
        </div>
        <div class="tp-rfq-field">
          <label>Message / Specifications <span>*</span></label>
          <textarea name="message" rows="5" required></textarea>
        </div>
        <button type="submit" class="tp-btn-primary tp-btn-block">Send Tube &amp; Pipe Inquiry</button>
        <p class="tp-rfq-privacy">Your information will only be used to respond to your inquiry and support your project review. We respect your privacy.</p>
      </form>
    </div>
  </section>
</BaseLayout>

<style>
/* ===== HERO ===== */
.tp-hero { position: relative; min-height: 680px; padding: 5rem 0 4rem; color: #fff; overflow: hidden; display: flex; align-items: center; justify-content: flex-start; }
.tp-hero-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 1; }
.tp-hero-overlay { position: absolute; inset: 0; background: linear-gradient(90deg, #020617 0%, rgba(2,6,23,0.9) 50%, rgba(23,37,84,0.45) 100%); z-index: 2; }
