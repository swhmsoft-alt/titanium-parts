---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import RFQForm from '../../components/RFQForm.astro';
import Icon from '../../components/Icon.astro';
import { company } from '../../data/company';
---
<BaseLayout title="About Titanium Parts | Engineering & Sourcing Support" description="An independent engineering and sourcing resource for titanium mill products, coated anodes and electrochemical components, coordinated with partner workshops in China.">
<PageHero eyebrow="About" title="About Titanium Parts" description="Titanium products, coated anodes and electrochemical components, reviewed and coordinated for OEMs, EPC contractors and system integrators worldwide." />
<section class="section section-white"><div class="container"><div class="about-intro"><div><span class="section-title-eyebrow">Who We Are</span><h2>Titanium &amp; Anode Engineering and Sourcing Support</h2><p>Titanium Parts is an independent engineering and sourcing resource for titanium mill products, coated anodes and electrochemical components. We work with qualified partner workshops in China, and coordinate specification review, drawing check, production follow-up, inspection and documentation so buyers deal with a single technical contact.</p><p>Our supply scope covers traceable titanium mill products and machined components, custom MMO / platinized titanium anodes, and PEM-related components. Every order runs through the same technical contact, from drawing review to the shipment document package.</p></div><div class="about-stats"><div class="about-stat"><div class="about-stat-num">3</div><div class="about-stat-label">Product Families Coordinated</div></div><div class="about-stat"><div class="about-stat-num">1</div><div class="about-stat-label">Technical Contact Point</div></div><div class="about-stat"><div class="about-stat-num">Per Order</div><div class="about-stat-label">Specification Review</div></div><div class="about-stat"><div class="about-stat-num">Per Order</div><div class="about-stat-label">Inspection &amp; Documentation Plan</div></div></div></div></div></section>
<section class="section section-slate-50"><div class="container"><div class="section-header"><span class="section-title-eyebrow">Company Identity</span><h2 class="section-title">One Brand, Three Connected Product Businesses</h2></div><p class="identity-text">Titanium Parts is the brand we use for titanium mill products, coated anodes and electrochemical components. Production runs through qualified partner workshops in China, and one technical contact stays with the order from specification through shipment documentation.</p><div class="snapshot-grid"><div class="snapshot-card"><h3>What We Coordinate</h3><p>Titanium mill products, machined titanium components, custom MMO and platinized titanium anodes, and PEM-related components, supplied through qualified partner workshops in China.</p></div><div class="snapshot-card"><h3>Who We Serve</h3><p>Global OEMs, EPC teams, system integrators, hydrogen developers, water treatment companies, and industrial project buyers.</p></div><div class="snapshot-card"><h3>Why Buyers Choose Us</h3><p>Specification review, application selection support, coordinated inspection and documentation, and responsive follow-up for ongoing projects.</p></div></div></div></section>
<section class="section section-slate-50"><div class="container"><div class="section-header"><span class="section-title-eyebrow">Strategic Pillars</span><h2 class="section-title">The TITANIUM PARTS Advantage</h2><p class="section-desc">Beyond product supply, we reduce procurement uncertainty by defining the supply scope, technical basis, inspection points, and required documents.</p></div><div class="pillars-grid"><div class="pillar-card"><div class="pillar-num">01</div><h3>Connected Supply Scope</h3><p>Across titanium materials, CNC machining, custom anodes, and PEM components.</p></div><div class="pillar-card"><div class="pillar-num">02</div><h3>Application-Specific Engineering</h3><p>We review materials, coatings, geometry, documentation, and system configuration.</p></div><div class="pillar-card"><div class="pillar-num">03</div><h3>Order-Specific Quality Control</h3><p>Defined production and inspection checkpoints support traceability and consistency.</p></div><div class="pillar-card"><div class="pillar-num">04</div><h3>Global OEM Supply Support</h3><p>We support OEMs, EPC teams, and system integrators with delivery planning and export documents.</p></div></div></div></section>
<section class="section section-white"><div class="container"><div class="section-header"><span class="section-title-eyebrow">OEM and Project Collaboration</span><h2 class="section-title">From Technical Review to Documented Delivery</h2></div><div class="process-grid"><div class="process-step"><div class="process-num">01</div><h3>Define the order basis</h3><p>Review application, specifications, drawings, interfaces and the proposed supply boundary.</p></div><div class="process-step"><div class="process-num">02</div><h3>Coordinate manufacturing</h3><p>Match the product family to the relevant process route, inspection points and documentation plan.</p></div><div class="process-step"><div class="process-num">03</div><h3>Release with evidence</h3><p>Confirm the records, test results, packing and handover documents required by the project.</p></div><div class="process-step"><div class="process-num">04</div><h3>Support production & delivery</h3><p>For approved projects, we coordinate production, inspection, packing, export documents, and shipment follow-up.</p></div></div></div></section>
<section class="section section-dark"><div class="container"><div class="rfq-grid"><div><span class="section-title-eyebrow" style="color: var(--color-primary-200);">Talk with the Titanium Parts Team</span><h2 class="rfq-title">If you are evaluating Titanium Parts as a supplier, tell us the product family, project scope and approval requirements.</h2><ul class="rfq-benefits"><li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#4ADE80" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Product family and application</li><li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#4ADE80" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Technical or drawing requirements</li><li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#4ADE80" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Inspection and supplier-approval needs</li><li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#4ADE80" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Project timing and next decision</li></ul><p class="rfq-prefer">Prefer email? <a href="mailto:sales@titanium-parts.com">sales@titanium-parts.com</a></p></div><RFQForm title="Project Inquiry" subtitle="Tell us what you are developing or sourcing." variant="default" /></div></div></section>
</BaseLayout>
