    { "type": "fileExists", "path": "src/data/comparison-table-model.ts" },
    { "type": "fileExists", "path": "src/components/ComparisonTable.astro" },

    { "type": "fileContains", "path": "package.json", "text": "qa:geo" },
    { "type": "fileContains", "path": "src/layouts/BaseLayout.astro", "text": "PUBLIC_GTM_ID" },
    { "type": "fileContains", "path": "src/layouts/BaseLayout.astro", "text": "PUBLIC_GA4_ID" },
    { "type": "fileContains", "path": "src/layouts/BaseLayout.astro", "text": "ai_referrer_host" },

    { "type": "fileContains", "path": "docs/seo/geo-audit-findings.md", "text": "风险整改清单" },
