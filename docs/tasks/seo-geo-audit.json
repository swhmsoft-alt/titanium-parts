    { "type": "fileContains", "path": "docs/seo/product-comparison-table-template.md", "text": "产品参数对比表模板" },

    { "type": "fileContains", "path": "src/components/ComparisonTable.astro", "text": "scope=\"col\"" },
    { "type": "fileContains", "path": "src/components/ComparisonTable.astro", "text": "scope=\"row\"" },
    { "type": "fileContains", "path": "src/components/ComparisonTable.astro", "text": "<caption>" },
    { "type": "fileContains", "path": "src/data/comparison-table-model.ts", "text": "toSchemaProperties" },

    { "type": "pageCount", "min": 77 }
