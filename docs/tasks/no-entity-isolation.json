{
  "id": "no-entity-isolation",
  "title": "The site is closed to crawlers and carries no entity claim it cannot prove",
  "summary": "While the company is not registered, the site must not be indexed and must not claim facilities, addresses or a history it cannot document. This round closes crawling, adds noindex to every built page, removes the three self-owned site addresses from the shared configuration, the Organization schema and every page that printed them, and rewrites the shared positioning into an independent engineering and sourcing resource coordinated with qualified production partners in China. The site stays isolated until the de-originalisation and rewrite work is finished.",
  "assertions": [
    { "type": "fileExists", "path": "docs/tasks/no-entity-isolation.json" },

    { "type": "fileContains", "path": "public/robots.txt", "text": "Disallow: /" },
    { "type": "fileLacks", "path": "public/robots.txt", "text": "Allow: /" },
    { "type": "fileLacks", "path": "public/robots.txt", "text": "Sitemap:" },

    { "type": "allRoutesContain", "text": "<meta name=\"robots\" content=\"noindex, nofollow\">" },

    { "type": "fileContains", "path": "src/layouts/BaseLayout.astro", "text": "noindex = true" },
    { "type": "fileLacks", "path": "src/layouts/BaseLayout.astro", "text": "site.locations" },
    { "type": "fileLacks", "path": "src/layouts/BaseLayout.astro", "text": "addressCountry" },
    { "type": "fileLacks", "path": "src/layouts/BaseLayout.astro", "text": "foundingDate:" },

    { "type": "fileContains", "path": "src/data/site.ts", "text": "Independent engineering and sourcing resource for titanium products, coated anodes and electrochemical components, coordinated with qualified production partners in China." },
    { "type": "fileContains", "path": "src/data/site.ts", "text": "Titanium & Anode Sourcing and Engineering Support" },
    { "type": "fileContains", "path": "src/data/site.ts", "text": "sourcing: {" },
    { "type": "fileLacks", "path": "src/data/site.ts", "text": "locations:" },
    { "type": "fileLacks", "path": "src/data/site.ts", "text": "yearsExperience" },
    { "type": "fileLacks", "path": "src/data/site.ts", "text": "teamSize" },
    { "type": "fileLacks", "path": "src/data/site.ts", "text": "Baoji City" },
    { "type": "fileLacks", "path": "src/data/site.ts", "text": "Ningbo" },
    { "type": "fileLacks", "path": "src/data/site.ts", "text": "Dongguan" },
    { "type": "fileLacks", "path": "src/data/site.ts", "text": "Titanium Valley" },

    { "type": "routeLacks", "route": "/", "text": "Titanium Valley" },
    { "type": "routeLacks", "route": "/contact/", "text": "Titanium Valley" },
    { "type": "routeLacks", "route": "/contact/", "text": "main manufacturing hub" },
    { "type": "routeLacks", "route": "/", "text": "addressCountry" },
    { "type": "routeContains", "route": "/", "text": "Sourcing base in the Baoji titanium industrial cluster, China" },
    { "type": "routeContains", "route": "/contact/", "text": "Sourcing Base" },

    { "type": "fileLacks", "path": "src/components/Footer.astro", "text": "locations.hq" },
    { "type": "fileLacks", "path": "src/components/anode/ProductPage.astro", "text": "locations.hq" },
    { "type": "fileLacks", "path": "src/pages/titanium-machining-parts.astro", "text": "locations.hq" },
    { "type": "fileLacks", "path": "src/pages/contact/index.astro", "text": "locations.hq" },

    { "type": "pageCount", "min": 67 }
  ]
}
