      "groups": [
        { "label": "Mill Products", "childCount": 6 },
        { "label": "Forgings & Clad Materials", "childCount": 2 },
        { "label": "Piping Components", "childCount": 2 },
        { "label": "Electrochemical & Mesh Fabrications", "childCount": 3 },
        { "label": "Fasteners & Precision Machined Parts", "childCount": 3 }
