    { "type": "routeExists", "route": "/titanium-products/titanium-rod-bar/" },
    { "type": "routeExists", "route": "/titanium-products/titanium-tubing/" },
    { "type": "routeExists", "route": "/titanium-products/titanium-wire/" },
    { "type": "routeExists", "route": "/titanium-products/titanium-forgings/" },
    { "type": "routeExists", "route": "/titanium-products/titanium-clad-copper/" },
    { "type": "routeExists", "route": "/titanium-products/titanium-fittings/" },
    { "type": "routeExists", "route": "/titanium-products/titanium-flanges/" },
    { "type": "routeExists", "route": "/titanium-products/titanium-mesh/" },
    { "type": "routeExists", "route": "/titanium-products/titanium-baskets/" },
