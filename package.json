{
  "name": "titanium-cnc",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "node scripts/handoff/gate.mjs exec -- astro build",
    "build:direct": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "budget": "node scripts/handoff/budget.mjs",
    "gate": "node scripts/handoff/gate.mjs",
    "gate:audit": "node scripts/handoff/gate.mjs audit",
    "grep": "node scripts/grep.mjs",
    "newtask": "node scripts/handoff/newtask.mjs",
    "qa": "npm run build && node scripts/qa/run-all.mjs",
    "qa:audit": "node scripts/qa/audit.mjs",
    "qa:seo": "node scripts/qa/verify-seo.mjs",
    "qa:links": "node scripts/qa/list-dead-links.mjs",
    "qa:routes": "node scripts/qa/build-routes.mjs",
    "qa:geo": "node scripts/seo/geo-audit.mjs",
    "qa:elig": "node scripts/seo/source-eligibility-audit.mjs",
    "task:verify": "node scripts/qa/run.mjs verify-task -- node scripts/qa/verify-task.mjs",
    "task:list": "node scripts/qa/verify-task.mjs --list",
    "media:scan": "node scripts/media/scan-slots.mjs",
    "media:replace": "node scripts/media/replace-media.mjs",
    "media:order": "node scripts/media/shooting-order.mjs",
    "media:alt": "node scripts/media/draft-alt-text.mjs",
    "brand:og": "node scripts/brand/make-og-image.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.2.0",
    "astro": "^5.14.1"
  },
  "devDependencies": {
    "sharp": "^0.34.5"
  }
}
